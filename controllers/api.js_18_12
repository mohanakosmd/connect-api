/* check connected call and doctor by call Id api(08092018)*/
exports.checkConnectCallBycallId = function (req, res) {
  logger.info("api checkConnectCallBycallId call_id ", req.body.call_id);
  if (req.body.call_id == "" || req.body.call_id == undefined) {
    logger.error(
      'api checkConnectCallBycallId -Error_Message -validation failed "call_id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = {
    call_id: req.body.call_id,
    phone: req.body.phone,
  };
  var query =
    "Select * from connect_call_log where call_id = '" +
    params.call_id +
    "' AND is_completed != 0";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api checkConnectCallBycallId -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else if (rows.length > 0) {
      res
        .status(404)
        .json({ status_code: 404, status_message: "The link has expired." });
    } else {
      if (params.phone) {
        try {
          var q = "select * from doctor where phoneNo ='" + params.phone + "'";
          db.query(q, function (err, doctorrows) {
            if (err) {
              logger.error(
                "api checkConnectCallBycallId -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else if (doctorrows.length > 0) {
              var query =
                "Select * from patient_record where doctor_id != 0 And id = '" +
                params.call_id +
                "'";
              var sql = db.query(query, function (err, rows, fields) {
                if (err) {
                  logger.error(
                    "api checkConnectCallBycallId -Error_Code :-",
                    err.code,
                    "Error_Message :-",
                    err.sqlMessage,
                    "  :",
                    __line
                  );
                  res.status(500).json({
                    status_code: 500,
                    status_message: "internal server error",
                  });
                } else if (rows.length > 0) {
                  if (rows[0].doctor_id == doctorrows[0].id) {
                    res.status(200).json({
                      status_code: 200,
                      status_message: "Doctor not found",
                    });
                  } else {
                    res.status(402).json({
                      status_code: 402,
                      status_message:
                        "It looks like the case has already been assigned to another doctor. Thank you.",
                    });
                  }
                } else {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "Doctor not found",
                  });
                }
              });
            } else {
              res.status(402).json({
                status_code: 402,
                status_message:
                  "Sorry, but we couldn't recognize you based on the information you provided. Please correct and submit again.",
              });
            }
          });
        } catch (err) {}
      } else {
        res
          .status(200)
          .json({ status_code: 200, status_message: "call connected" });
      }
    }
  });
};

exports.appCallReconnect = function (req, res) {
  logger.info("api appCallReconnect patient_id", req.body.patient_id);
  if (req.body.patient_id == undefined || req.body.patient_id == "") {
    logger.error(
      'api appCallReconnect -Error_Message -validation failed "patient_id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = {
    patient_id: req.body.patient_id,
  };
  var query =
    "Select * from connect_waiting_room where patient_id = '" +
    params.patient_id +
    "'";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api appCallReconnect -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else if (rows.length > 0) {
      if (
        rows[0].status &&
        (rows[0].status.toLowerCase() == "pending" ||
          rows[0].status.toLowerCase() == "in progress" ||
          rows[0].status.toLowerCase() == "in consultation")
      ) {
        var data = {};
        data.session = rows[0].session;
        data.token = rows[0].token;
        data.call_id = rows[0].call_id;
        data.status = rows[0].status;
        data.checked_in = moment(rows[0].checked_in).format(
          "MM/DD/YYYY hh:mm A"
        );
        data.apiKey = config.opentok.opentokApiKey;
        res.status(200).json({
          status_code: 200,
          status_message:
            "We noticed that you were not able to finish the last call. Do you want to resume?",
          result: data,
        });
      } else {
        res.status(404).json({
          status_code: 404,
          status_message: "Patient status mismatch",
        });
      }
    } else {
      res
        .status(404)
        .json({ status_code: 404, status_message: "Patient not found" });
    }
  });
};
var insertexceldataindb = function (exceldata, index, employer_id, res) {
  if (index == exceldata.length) {
    return res.status(200).json({
      status_code: 200,
      status_message: "You have uploaded data successfully",
    });
  }
  var params = {
    employer_id: employer_id,
    name: exceldata[index]["doc name"],
    street: exceldata[index]["doc street"],
    city: exceldata[index]["doc city"],
    state: exceldata[index]["doc state"],
    zip_code: exceldata[index]["doc zip"],
  };
  if (params.name != "") {
    var query = 'SELECT * FROM wc_locations WHERE name = "' + params.name + '"';
    db.query(query, function (error, rows) {
      if (error) {
        insertexceldataindb(exceldata, index, employer_id, res);
      } else {
        if (rows.length > 0) {
          if (compareobject(rows[0], params)) {
            insertwcreferral(exceldata, index, rows[0].id, employer_id, res);
          } else {
            if (
              params.name != "" &&
              params.city != "" &&
              params.street != "" &&
              params.employer_id != "" &&
              params.state != "" &&
              params.zip_code
            ) {
              db.query(
                "UPDATE wc_locations SET ? WHERE id =" + rows[0].id + "",
                params,
                function (err, rowsupdae, fields) {
                  if (error) {
                    insertexceldataindb(exceldata, index, employer_id, res);
                  } else {
                    if (rowsupdae) {
                      insertwcreferral(
                        exceldata,
                        index,
                        rows[0].id,
                        employer_id,
                        res
                      );
                    }
                  }
                }
              );
            } else {
              insertwcreferral(exceldata, index, rows[0].id, employer_id, res);
            }
          }
        } else {
          if (
            params.name != "" &&
            params.city != "" &&
            params.street != "" &&
            params.employer_id != "" &&
            params.state != "" &&
            params.zip_code
          ) {
            db.query(
              "INSERT INTO wc_locations SET ?",
              params,
              function (err, rows, fields) {
                if (error) {
                  insertwcreferral(
                    exceldata,
                    index,
                    rows[0].id,
                    employer_id,
                    res
                  );
                } else {
                  if (rows) {
                    insertwcreferral(
                      exceldata,
                      index,
                      rows.insertId,
                      employer_id,
                      res
                    );
                  }
                }
              }
            );
          } else {
            insertexceldataindb(exceldata, index + 1, employer_id, res);
          }
        }
      }
    });
  } else {
    insertexceldataindb(exceldata, index + 1, employer_id, res);
  }
};
var insertwcreferral = function (
  exceldata,
  index,
  locationid,
  employer_id,
  res
) {
  var params = {
    employer_id: employer_id,
    wc_location_id: locationid,
    speciality_type: exceldata[index]["specialty"] || "Nearby Location",
    practice_name: exceldata[index]["name"],
    provider_name: exceldata[index]["group"],
    practice_address: exceldata[index]["address"],
    city: exceldata[index]["city"],
    state: exceldata[index]["state"],
    zip: exceldata[index]["zip"],
    location_type: "OTHER",
    email: "",
    phone: exceldata[index]["phone"],
    fax: "",
    preferred_referral_method: "phone",
    hours_of_operation: "",
  };
  if (
    params.practice_name != "" &&
    params.practice_address != "" &&
    params.wc_location_id != ""
  ) {
    var query =
      'SELECT * FROM wc_referrals WHERE practice_name = "' +
      params.practice_name +
      '" AND practice_address ="' +
      params.practice_address +
      '" AND wc_location_id = "' +
      params.wc_location_id +
      '"';
    db.query(query, function (error, rows) {
      if (error) {
        insertwcreferral(exceldata, index, locationid, employer_id, res);
      } else {
        if (rows.length > 0) {
          if (compareobject(rows[0], params)) {
            insertexceldataindb(exceldata, index + 1, employer_id, res);
          } else {
            if (
              params.speciality_type != "" &&
              params.city != "" &&
              params.state != "" &&
              params.zip != "" &&
              params.phone != ""
            ) {
              db.query(
                "UPDATE wc_referrals SET ? WHERE id =" + rows[0].id + "",
                params,
                function (err, rowsupdae, fields) {
                  if (error) {
                    insertwcreferral(
                      exceldata,
                      index,
                      locationid,
                      employer_id,
                      res
                    );
                  } else {
                    if (rows) {
                      insertexceldataindb(
                        exceldata,
                        index + 1,
                        employer_id,
                        res
                      );
                    }
                  }
                }
              );
            } else {
              insertexceldataindb(exceldata, index + 1, employer_id, res);
            }
          }
        } else {
          if (
            params.speciality_type != "" &&
            params.city != "" &&
            params.state != "" &&
            params.zip != "" &&
            params.phone != ""
          ) {
            db.query(
              "INSERT INTO wc_referrals SET ?",
              params,
              function (err, rows, fields) {
                if (error) {
                  insertwcreferral(
                    exceldata,
                    index,
                    locationid,
                    employer_id,
                    res
                  );
                } else {
                  if (rows) {
                    insertexceldataindb(exceldata, index + 1, employer_id, res);
                  }
                }
              }
            );
          } else {
            insertexceldataindb(exceldata, index + 1, employer_id, res);
          }
        }
      }
    });
  } else {
    insertexceldataindb(exceldata, index + 1, employer_id, res);
  }
};

var compareobject = function (firstobj, secondobj) {
  var fProps = Object.getOwnPropertyNames(firstobj);
  var sProps = Object.getOwnPropertyNames(secondobj);
  for (var i = 0; i < fProps.length; i++) {
    var propName = fProps[i];
    if (propName != "id") {
      if (
        firstobj[propName] &&
        firstobj[propName].toString().toLowerCase() != secondobj[propName] &&
        secondobj[propName].toString().toLowerCase()
      ) {
        return false;
      }
    }
  }
  return true;
};
exports.updatereferralsfors1medical = function (req, res) {
  logger.info("api -- updatereferralsfors1medical");
  var dir = "./uploads";
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir);
  }
  var storage = multer.diskStorage({
    destination: function (req, file, callback) {
      callback(null, "./uploads");
    },
    filename: function (req, file, callback) {
      var datetimestamp = Date.now();
      callback(
        null,
        datetimestamp +
          "." +
          file.originalname.split(".")[file.originalname.split(".").length - 1]
      );
    },
  });
  var upload = multer({
    storage: storage,
    onFileUploadStart: function (file) {
      console.log(file.originalname + " is starting ...");
    },
    fileFilter: function (req, file, callback) {
      var ext = path.extname(file.originalname);
      if (
        ["xls", "xlsx"].indexOf(
          file.originalname.split(".")[file.originalname.split(".").length - 1]
        ) === -1
      ) {
        return res.status(200).json({
          status_code: 402,
          status_message:
            "Please Choose the vaild file. xls or xlsx extension file",
        });
      }
      callback(null, true);
    },
  }).any("file[]", 10);
  upload(req, res, function (err) {
    if (err) {
      return res.status(200).json({
        status_code: 500,
        status_message: "Something went wrong. Please try again",
      });
    } else {
      if (req.files.length > 0) {
        if (
          req.files[0].originalname.split(".")[
            req.files[0].originalname.split(".").length - 1
          ] === "xlsx"
        ) {
          exceltojson = xlsxtojson;
        } else {
          exceltojson = xlstojson;
        }
        try {
          exceltojson(
            {
              input: req.files[0].path,
              output: null,
              lowerCaseHeaders: true,
            },
            function (err, result) {
              if (err) {
                return res.status(200).json({
                  status_code: 500,
                  status_message:
                    "Something went wrong in parsing excel. Please try again",
                });
              }
              var exceldatarefral = result;
              var excelcolrefral = [
                "address1",
                "address2",
                "city",
                "county",
                "data_date",
                "facility_name",
                "fax",
                "mem no",
                "member name",
                "notes",
                "phone",
                "physician",
                "state",
                "type",
                "zip",
              ];
              var countR = 0;
              for (var field in exceldatarefral[0]) {
                if (excelcolrefral.indexOf(field) > -1) {
                  countR = countR + 1;
                }
              }
              if (countR != excelcolrefral.length) {
                return res.status(200).json({
                  status_code: 500,
                  status_message:
                    "cells name should be matched :- address1, address2, city, county, data_date, facility_name, fax, mem no, member name, notes, phone, physician, state, type, zip",
                });
              }
              var clientname = "S1 medical";
              var employer_id = 393441;
              findlocationfors1medical(exceldatarefral, 0, employer_id, res);
            }
          );
        } catch (e) {
          return res.status(200).json({
            status_code: 500,
            status_message: "Something went wrong. Please try again",
          });
        }
      } else {
        return res.status(200).json({
          status_code: 500,
          status_message: "Something went wrong. Please try again",
        });
      }
    }
  });
};

var findlocationfors1medical = function (
  exceldatarefral,
  index,
  employer_id,
  res
) {
  if (index == exceldatarefral.length) {
    return res.status(200).json({
      status_code: 200,
      status_message: "You have update referrals data successfully",
    });
  } else {
    var params = {
      employer_id: employer_id,
      name: exceldatarefral[index]["member name"],
      practice_name: exceldatarefral[index]["facility_name"],
      provider_name: mysql_real_escape_string(
        exceldatarefral[index]["physician"]
      ),
      practice_address: exceldatarefral[index]["address1"],
      wc_location_id: "",
      speciality_type: "Occupational Health Clinic",
      city: exceldatarefral[index]["city"],
      state: exceldatarefral[index]["state"],
      zip: exceldatarefral[index]["zip"],
      location_type: exceldatarefral[index]["type"] || "OTHER",
      email: "",
      phone: exceldatarefral[index]["phone"],
      fax: exceldatarefral[index]["fax"],
      preferred_referral_method: "phone",
      hours_of_operation: "",
      notes: exceldatarefral[index]["notes"],
    };
    if (params.name != "") {
      var query =
        'SELECT * FROM wc_locations WHERE  TRIM(name) = "' +
        params.name.trim() +
        '" AND employer_id = "' +
        params.employer_id +
        '"';
      db.query(query, function (error, rows) {
        if (error) {
          findlocationfors1medical(
            exceldatarefral,
            index,
            params.employer_id,
            res
          );
        } else {
          if (rows.length > 0) {
            params.wc_location_id = rows[0].id;
            if (
              params.practice_name != "" &&
              params.practice_address != "" &&
              params.wc_location_id != "" &&
              params.provider_name != ""
            ) {
              var query =
                'SELECT * FROM wc_referrals WHERE  TRIM(practice_name) = "' +
                params.practice_name.trim() +
                '" AND TRIM(practice_address)  ="' +
                params.practice_address.trim() +
                '" AND wc_location_id = "' +
                params.wc_location_id +
                '"AND TRIM(provider_name) = "' +
                params.provider_name.trim() +
                '"';
              db.query(query, function (error, rows) {
                if (error) {
                  findlocationfors1medical(
                    exceldatarefral,
                    index,
                    params.employer_id,
                    res
                  );
                } else {
                  if (rows.length > 0) {
                    insertandupdatereferralfors1medical(
                      exceldatarefral,
                      index,
                      params.employer_id,
                      params.wc_location_id,
                      true,
                      res,
                      rows[0].id
                    );
                  } else {
                    insertandupdatereferralfors1medical(
                      exceldatarefral,
                      index,
                      params.employer_id,
                      params.wc_location_id,
                      false,
                      res
                    );
                  }
                }
              });
            } else {
              findlocationfors1medical(
                exceldatarefral,
                index + 1,
                params.employer_id,
                res
              );
            }
          } else {
            findlocationfors1medical(
              exceldatarefral,
              index + 1,
              params.employer_id,
              res
            );
          }
        }
      });
    } else {
      findlocationfors1medical(
        exceldatarefral,
        index + 1,
        params.employer_id,
        res
      );
    }
  }
};

var insertandupdatereferralfors1medical = function (
  exceldatarefral,
  index,
  employer_id,
  locationid,
  flag,
  res,
  referral_id
) {
  var params = {
    employer_id: employer_id,
    practice_name: exceldatarefral[index]["facility_name"],
    provider_name: mysql_real_escape_string(
      exceldatarefral[index]["physician"]
    ),
