                                          }
                                        }
                                      );
                                      // added the condition for resending_time data for phone type
                                    } else {
                                      res.status(404).json({
                                        status_code: 404,
                                        status_message: "not found",
                                      });
                                    }
                                  }
                                }
                              );
                            }
                          }
