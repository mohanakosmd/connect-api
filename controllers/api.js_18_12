          if (err) {
            logger.error(
              "api getProviderGroup -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "  :",
              __line
            );
            res.status(500).json({
              status_code: 500,
              status_message: "internal server error",
            });
          } else {
            if (rows) {
              res.status(200).json({
                status_code: 200,
                status_message: "connect provider group",
                result: rows,
              });
            } else {
              res
                .status(404)
                .json({ status_code: 404, status_message: "data not found" });
            }
          }
        });
      }
    }
  });
};
