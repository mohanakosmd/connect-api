//use to get client name from connect provider table
function getConnectClientName(employerId, registration_from, callback) {
  if (!employerId) {
    if (registration_from && registration_from.toLowerCase() == "cityhealth") {
      return callback({ client_name: "cityhealth" });
    } else {
      return callback({ client_name: "connect" });
    }
  }
  var query =
    "SELECT client_name FROM connect_provider WHERE employer_id = '" +
    employerId +
    "' ORDER BY id DESC LIMIT 1";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api getConnectClientName -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      return false;
    } else {
      if (rows.length > 0) {
        return callback(rows[0]);
      } else {
        return false;
      }
    }
  });
}
/* check if user exists for email or phone  */
exports.patientexistsemailphone = function (req, res) {
  logger.info("api patientexists email/phone =", req.body.emailphone);
  if (req.body.emailphone == "" || req.body.emailphone == "undefined") {
    logger.error(
      'api patientexists -Error_Message -validation failed "emailphone is required"   :',
      __line
    );
    return res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
  }
  var selectQuery =
    'SELECT id,phone,first_name,last_name,email,dateofbirth,gender,address1,city,state,zip_code,registration_from,uuid,hg_patient_id,password FROM patient WHERE (email = "' +
    req.body.emailphone +
    "\" OR phone = '" +
    req.body.emailphone +
    '\' ) and parent_id ="0" ';
  var query = selectQuery + " ORDER BY id DESC LIMIT 1";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api patientexists -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        getJwtAuthToken(
          rows[0].uuid,
          "patient-app",
          function (err, callbackresult) {
            if (err) {
              res
                .status(401)
                .json({ status_code: 401, status_message: errorAuthToken });
            } else if (callbackresult.status_code == 200) {
              rows[0].access_token = callbackresult.data.access_token;
              res.status(200).json({
                status_code: 200,
                status_message: "user exists",
                result: rows,
              });
            }
          }
        );
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "user not found" });
      }
    }
  });
};
