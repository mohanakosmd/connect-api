          result: rows,
        });
      } else {
        callback(null, {
          status_code: 404,
          status_message: "patient not found",
        });
      }
    }
  });
};
var generateHgPatientId = function (params, callback) {
  logger.info("api generateHgPatientId email=", params.email);
  Request.post(
    {
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
        Authorization:
          "Basic " +
          new Buffer(
            config.restapi.user + ":" + config.restapi.password
          ).toString("base64"),
      },
      url: config.restapi.baseurl + "/v1/healthgorilla/patients",
      body: JSON.stringify({
        firstName: params.first_name,
        lastName: params.last_name,
        gender: params.gender,
        birthDate: params.dateofbirth,
        identifier: params.patient_id,
        email: params.email,
      }),
    },
    (error, response, body) => {
      if (error) {
        logger.error(
          "api generateHgPatientId -Error_Code :-",
          error,
          "  :",
          __line
        );
        callback(true, null);
      } else {
        if (response.statusCode == 201) {
          var sql = db.query(
            "UPDATE patient SET hg_patient_id='" +
              JSON.parse(body).patientHGId +
              "' WHERE id='" +
              params.patient_id +
              "'",
            function (err, rowsupdate1, fields) {
              if (err) {
                logger.error(
                  "api generateHgPatientId -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                callback(true, null);
              } else {
                callback(null, {
                  status_code: 200,
                  status_message: "successfully update",
                });
              }
            }
          );
        } else {
          logger.error(
            "api generateHgPatientId Error_Message :-",
            JSON.parse(body).message,
            "  :",
            __line
          );
          callback(true, null);
        }
      }
    }
  );
};

var getJwtAuthToken = function (uuid, type, callback) {
  logger.info("api getJwtAuthToken uuid=", uuid, config.newapi.baseurl);

  Request.post(
    {
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
      },
      url: config.newapi.baseurl + "/v1/tokens",
      body: JSON.stringify({
        uuid: uuid,
        role: type,
      }),
    },
    (error, response, body) => {
      if (error) {
        logger.error(
          "api getJwtAuthToken -Error_Code :-",
          error.message,
          "  :",
          __line
        );
        callback(true, null);
      } else {
        console.log(response.statusCode);
        if (response.statusCode == 201) {
          if (JSON.parse(body) && JSON.parse(body).access_token) {
            callback(null, {
              status_code: 200,
              status_message: "successfully update",
              data: JSON.parse(body),
            });
          } else {
            callback(true, null);
          }
        } else {
          logger.error(
            "api getJwtAuthToken -Error_Code :-",
            error,
            "  :",
            __line
          );
          callback(true, null);
        }
      }
    }
  );
};

var practiceSuitePatientRegister = function (uuid) {
  logger.info("api practiceSuitePatientRegister uuid=", uuid);
  // Setting URL and headers for request
  var options = {
    url: config.newapi.baseurl + "/v1/practicesuite/patients",
    body: JSON.stringify({
      patientId: uuid,
    }),
    headers: {
      "Content-Type": "application/x-www-form-urlencoded",
      Authorization:
        "Basic " +
        new Buffer(
          config.restapi.user + ":" + config.restapi.password
        ).toString("base64"),
    },
  };
  // Return new promise
  return new Promise(function (resolve, reject) {
    // Do async job
    Request.post(options, function (err, resp, body) {
      if (err) {
        reject(err);
      } else {
        resolve(JSON.parse(body));
      }
    });
  });
};
