        }
      }
    );
  }
};

/* get doc data from alias api */
exports.getDocFromAlias = function (req, res) {
  logger.info("api getDocFromAlias room", req.body.alias);
  var params = { alias: req.body.alias };
  if (params.alias == "") {
    logger.error(
      'api getDocFromAlias -Error_Message -validation failed "alias is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var sql = db.query(
      "SELECT id,name,employer_id,is_active FROM connect_provider WHERE room_alias = '" +
        params.alias +
        "'  OR room = '" +
        params.alias +
        "'",
      params,
      function (err, rows, fields) {
        if (err) {
          logger.error(
            "api getDocFromAlias -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          if (rows.length > 0) {
            var sql = db.query(
              "SELECT * FROM connect_provider_groups WHERE connect_provider_id = '" +
                rows[0].id +
                "'",
              function (err, rows1, fields) {
                if (err) {
                  logger.error(
                    "api getDocFromAlias -Error_Code :-",
                    err.code,
                    "Error_Message :-",
                    err.sqlMessage,
                    "  :",
                    __line
                  );
                  res.status(500).json({
                    status_code: 500,
                    status_message: "internal server error",
                  });
                }
                if (rows1.length > 0) {
                  getgroupname(params, res);
                } else {
                  rows[0].group_id = 0;
                  rows[0].employer_id = "";
                  rows[0].company_name = "";
                  res.status(200).json({
                    status_code: 200,
                    status_message: "Doctor Data",
                    result: rows,
                  });
                }
              }
            );
          } else {
            getgroupname(params, res);
          }
        }
      }
    );
  }
};
