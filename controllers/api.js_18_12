/* save user meeting details api */
exports.saveUserMeeting = function (req, res) {
  var employerId = req.body.employerId || "";
  logger.info("api saveUserMeeting phone=", req.body.phone);
  if (req.body.phone == "" || req.body.phone == undefined) {
    logger.error(
      'api saveUserMeeting -Error_Message -validation failed "phone is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = {
    first_name: req.body.first_name,
    last_name: req.body.last_name,
    email: req.body.email,
    phone: req.body.phone,
    image_url: "",
    gender: req.body.gender,
    address1: req.body.address1,
    state: req.body.state,
    city: req.body.city,
    zip_code: req.body.zip_code,
    role: "",
    registration_from: req.body.registration_from,
    is_email_verified: 1,
    password: crypto.createHash("md5").update(req.body.password).digest("hex"),
  };

  if (req.body.email != "") {
    var q =
      "SELECT id,uuid,registration_from,ps_patient_id FROM patient  WHERE  email ='" +
      req.body.email +
      "' AND first_name='" +
      req.body.first_name +
      "' AND last_name ='" +
      req.body.last_name +
      "'";
  } else {
    var q =
      "SELECT id,uuid,registration_from,ps_patient_id FROM patient  WHERE  phone ='" +
      req.body.phone +
      "' AND  first_name='" +
      req.body.first_name +
      "' AND last_name ='" +
      req.body.last_name +
      "'";
  }
  db.query(q, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api saveUserMeeting -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        params.patient_id = rows[0].id;
        params.uuid = rows[0].uuid;
        params.registration_from = rows[0].registration_from;
        params.ps_patient_id = rows[0].ps_patient_id; //practicesuite patient id
        if (params.ps_patient_id === "") {
          logger.info(
            "start submitting to practicesuite create patient api",
            __line
          );
          //start- register with practicesuite
          practiceSuitePatientRegister(params.uuid).then(
            function (result) {
              logger.info(
                "Patient details successfully submitted to practicesuite create patient api",
                __line
              );
            },
            function (err) {
              logger.info(
                "Something went wrong while submitting patient details to practicesuite create patient api",
                __line
              );
            }
          );
          //End- register with practicesuite
        }
        getJwtAuthToken(
          params.uuid,
          "patient-app",
          function (err, callbackresult) {
            if (err) {
              res
                .status(401)
                .json({ status_code: 401, status_message: errorAuthToken });
            } else if (callbackresult.status_code == 200) {
              params.access_token = callbackresult.data.access_token;
              res.status(200).json({
                status_code: 200,
                status_message: "user already exists",
                result: params,
              });
            }
          }
        );
      } else {
        params.pin = Math.floor(1000 + Math.random() * 9999);
        params.uuid = uuidv4();
        var checked_in = new Date();
        params.created_at = moment(checked_in).format("YYYY-MM-DD HH:mm:ss");
        params.is_active = 1;
        if (req.body.dateofbirth && req.body.dateofbirth != "") {
          params.dateofbirth = moment(req.body.dateofbirth).format(
            "YYYY-MM-DD HH:mm:ss"
          );
        }
        if (employerId != "") {
          params.employer_id = employerId;
        }
        if (
          req.body.employer_name &&
          req.body.employer_name != "" &&
          req.body.employer_name != null
        ) {
          params.registration_from = req.body.employer_name;
          var sql = db.query(
            "SELECT employer_id FROM worksman_company_list  WHERE  company_name ='" +
              mysql_real_escape_string(req.body.employer_name) +
              "'",
            function (err, companyrows, fields) {
              if (err) {
                logger.error(
                  "api saveUserMeeting -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (companyrows.length > 0) {
                  params.employer_id = companyrows[0].employer_id;
                }
                var sql = db.query(
                  "INSERT INTO patient SET ?",
                  params,
                  function (err, rows, fields) {
                    if (err) {
                      logger.error(
                        "api saveUserMeeting -Error_Code :-",
                        err.code,
                        "Error_Message :-",
                        err.sqlMessage,
                        "  :",
                        __line
                      );
                      res.status(500).json({
                        status_code: 500,
                        status_message: "internal server error",
                      });
                    } else {
                      if (rows) {
                        var result = {};
                        result.patient_id = rows.insertId;
                        result.registration_from = params.registration_from;
                        result.uuid = params.uuid;
                        logger.info(
                          "start submitting to practicesuite create patient api",
                          __line
                        );
                        //start- register with practicesuite
                        practiceSuitePatientRegister(params.uuid).then(
                          function (result) {
                            logger.info(
                              "Patient details successfully submitted to practicesuite create patient api",
                              __line
                            );
                          },
                          function (err) {
                            logger.info(
                              "Something went wrong while submitting patient details to practicesuite create patient api",
                              __line
                            );
                          }
                        );
                        //End- register with practicesuite
                        getJwtAuthToken(
                          result.uuid,
                          "patient-app",
                          function (err, callbackresult) {
                            if (err) {
                              res.status(401).json({
                                status_code: 401,
                                status_message: errorAuthToken,
                              });
                            } else if (callbackresult.status_code == 200) {
                              result.access_token =
                                callbackresult.data.access_token;
                              res.status(200).json({
                                status_code: 200,
                                status_message: "user added",
                                result: result,
                              });
                            }
                          }
                        );
                      } else {
                        res.status(404).json({
                          status_code: 404,
                          status_message: "user not found",
                        });
                      }
                    }
                  }
                );
              }
            }
          );
        } else {
          var sql = db.query(
            "INSERT INTO patient SET ?",
            params,
            function (err, rows, fields) {
              if (err) {
                logger.error(
                  "api saveUserMeeting -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (rows) {
                  var result = {};
                  result.patient_id = rows.insertId;
                  result.registration_from = params.registration_from;
                  result.uuid = params.uuid;
                  logger.info(
                    "start submitting to practicesuite create patient api",
                    __line
                  );
                  //start- register with practicesuite
                  practiceSuitePatientRegister(params.uuid).then(
                    function (result) {
                      logger.info(
                        "Patient details successfully submitted to practicesuite create patient api",
                        __line
                      );
                    },
                    function (err) {
                      logger.info(
                        "Something went wrong while submitting patient details to practicesuite create patient api",
                        __line
                      );
                    }
                  );
                  //End- register with practicesuite
                  getJwtAuthToken(
                    result.uuid,
                    "patient-app",
                    function (err, callbackresult) {
                      if (err) {
                        res.status(401).json({
                          status_code: 401,
                          status_message: errorAuthToken,
                        });
                      } else if (callbackresult.status_code == 200) {
                        result.access_token = callbackresult.data.access_token;
                        res.status(200).json({
                          status_code: 200,
                          status_message: "user added",
                          result: result,
                        });
                      }
                    }
                  );
                } else {
                  res.status(404).json({
                    status_code: 404,
                    status_message: "user not found",
                  });
                }
              }
            }
          );
        }
      }
    }
  });
};

/*update transaction id in connect call log by call id*/
exports.updatetransactionid = function (req, res) {
  logger.info("api updatetransactionid transaction =" + req.body.transactionId);
  var params = {
    transactionId: req.body.transactionId,
    call_id: req.body.call_id,
    patient_id: req.body.patient_id,
  };
  if (
    params.transactionId == "" ||
    params.transactionId == undefined ||
    params.call_id == "" ||
    params.call_id == undefined
  ) {
    logger.error(
      'api updatetransactionid -Error_Message -validation failed "transactionId,call_id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var insertData = db.query(
    "UPDATE connect_call_log SET akoslive_transaction_id = '" +
      params.transactionId +
      "' WHERE call_id='" +
      params.call_id +
      "'",
    function (err, rows, fields) {
      if (err) {
        logger.error(
          "api updatetransactionid -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows) {
          var insertData = db.query(
            "UPDATE google_cloud_storage_meta_data SET call_id = '" +
              params.call_id +
              "',user_id= '" +
              params.patient_id +
              "' WHERE transaction_id='" +
              params.transactionId +
              "'",
            function (err, rowsupdate, fields) {
              if (err) {
                logger.error(
                  "api updatetransactionid -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(200).json({
                  status_code: 200,
                  status_message: "update successfully",
                  result: rows,
                });
              } else {
                if (rows) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "update successfully",
                    result: rows,
                  });
                } else {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "update successfully",
                    result: rows,
                  });
                }
              }
            }
          );
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "not found" });
        }
      }
    }
  );
};
