/*upload file for location (08182018)*/
exports.uploadfileonbucket = function (req, res) {
  logger.info("api uploadfileonbucket");
  var dir = "./uploads";
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir);
  }
  var storage = multer.diskStorage({
    destination: function (req, file, callback) {
      callback(null, "./uploads");
    },
    filename: function (req, file, callback) {
      var datetimestamp = Date.now();
      callback(
        null,
        datetimestamp +
          "." +
          file.originalname.split(".")[file.originalname.split(".").length - 1]
      );
    },
  });
  var upload = multer({
    storage: storage,
    onFileUploadStart: function (file) {
      console.log(file.originalname + " is starting ...");
    },
    fileFilter: function (req, file, callback) {
      var ext = path.extname(file.originalname);
      if (
        ["xls", "xlsx"].indexOf(
          file.originalname.split(".")[file.originalname.split(".").length - 1]
        ) === -1
      ) {
        return res.status(200).json({
          status_code: 402,
          status_message:
            "Please Choose the vaild file. xls or xlsx extension file",
        });
      }
      callback(null, true);
    },
  }).any("file[]", 10);
  upload(req, res, function (err) {
    if (err) {
      logger.error(
        "api uploadfileonbucket Error_Message :-",
        err,
        "  :",
        __line
      );
      return res.status(200).json({
        status_code: 500,
        status_message: "Something went wrong. Please try again",
      });
    } else {
      if (req.files.length > 0) {
        if (
          req.files[0].originalname.split(".")[
            req.files[0].originalname.split(".").length - 1
          ] === "xlsx"
        ) {
          exceltojson = xlsxtojson;
        } else {
          exceltojson = xlstojson;
        }
        try {
          exceltojson(
            {
              input: req.files[0].path,
              output: null,
              lowerCaseHeaders: true,
            },
            function (err, result) {
              if (err) {
                logger.error(
                  "api uploadfileonbucket Error_Message :-",
                  err,
                  "  :",
                  __line
                );
                return res.status(200).json({
                  status_code: 500,
                  status_message:
                    "Something went wrong in parsing excel. Please try again",
                });
              }
              var exceldata = result;
              var excelcol = [
                "doc city",
                "client",
                "city",
                "doc date",
                "doc name",
                "doc state",
                "doc street",
                "doc zip",
                "group",
                "name",
                "panel location#",
                "phone",
                "specialty",
                "state",
                "zip",
              ];
              var count = 0;
              for (var field in result[0]) {
                if (excelcol.indexOf(field) > -1) {
                  count = count + 1;
                }
              }
              if (count != excelcol.length) {
                return res.status(200).json({
                  status_code: 500,
                  status_message:
                    "cells name should be matched :- Client,Doc City,Doc Date,Doc Name,Doc State,Doc Street,Doc Zip,Group,Name,Phone,Specialty,City,State,Zip",
                });
              }
              var clientname = "";
              for (var cname in exceldata) {
                if (exceldata[cname].client) {
                  clientname = exceldata[cname].client;
                  break;
                }
              }
              var query =
                'SELECT * FROM worksman_company_list WHERE company_name = "' +
                clientname +
                '"';
              db.query(query, function (error, rows) {
                if (error) {
                  logger.error(
                    "api uploadfileonbucket -Error_Code :-",
                    error.code,
                    "Error_Message :-",
                    error.sqlMessage,
                    "  :",
                    __line
                  );
                  return res.status(200).json({
                    status_code: 500,
                    status_message: "Something went wrong. Please try again",
                  });
                } else {
                  if (rows.length > 0) {
                    insertexceldataindb(exceldata, 0, rows[0].employer_id, res);
                  } else {
                    return res.status(200).json({
                      status_code: 402,
                      status_message:
                        "Your company is not registered with Akos, Please write us to set your account.",
                    });
                  }
                }
              });
            }
          );
        } catch (e) {
          return res.status(200).json({
            status_code: 500,
            status_message: "Something went wrong. Please try again",
          });
        }
      } else {
        return res.status(200).json({
          status_code: 500,
          status_message: "Something went wrong. Please try again",
        });
      }
    }
  });
};
var groupBy = function (xs, key) {
  return xs.reduce(function (rv, x) {
    (rv[x[key]] = rv[x[key]] || []).push(x);
    return rv;
  }, {});
};

