exports.getPatientDetails = function (req, res) {
  logger.info("api getPatientDetails first name =", req.body.first_name);
  if (
    req.body.first_name == "" ||
    req.body.last_name == "" ||
    req.body.gender == "" ||
    req.body.dateofbirth == ""
  ) {
    logger.error(
      'api getPatientDetails -Error_Message -validation failed "first_name,last_name,gender,dateofbirth is required"    :',
      __line
    );
    return res.status(400).json({
      status_code: 400,
      status_message: "invalid parameter or value passed",
    });
  }
  var selectQuery =
    "SELECT * FROM patient WHERE first_name='" +
    req.body.first_name +
    "' AND last_name= '" +
    req.body.last_name +
    "' AND gender= '" +
    req.body.gender +
    "' AND dateofbirth= '" +
    req.body.dateofbirth +
    "' ORDER BY id DESC LIMIT 1";
  var sql = db.query(selectQuery, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api getPatientDetails -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "   :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        getJwtAuthToken(
          rows[0].uuid,
          "patient-app",
          function (err, callbackresult) {
            if (err) {
              res
                .status(401)
                .json({ status_code: 401, status_message: errorAuthToken });
            } else if (callbackresult.status_code == 200) {
              rows[0].access_token = callbackresult.data.access_token;
              res.status(200).json({
                status_code: 200,
                status_message: "user exists",
                result: rows[0],
              });
            }
          }
        );
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "user not found" });
      }
    }
  });
};
