//send speak
exports.plivoNotifyJoin = function (req, res) {
  let response = new plivo.Response();
  let speak_body =
    "A patient has checked in to the aekos telepresence waiting room, please login to connect to the portal and initiate the telepresence call.,,,,, ";
  var wait_params = {
    length: "3", // Time to wait in seconds
  };
  var speak_params = {
    loop: "30",
  };
  response.addSpeak(speak_body, speak_params);
  response.addSpeak("This call will now be disconnected. Good bye.");
  response.addWait(wait_params);
  console.log("--------------------------");
  res.send(response.toXML());
};

/* get dynamic checkin form field for other device */
/************************Get getCheckInFormFieldByRoom**************************************/
exports.getCheckInFormFieldByRoom = function (req, res) {
  logger.info("api getCheckInFormFieldByRoom room_name=", req.params.roomAlias);
  var q =
    "select connect_form_ui_element.*,connect_patient_checkin_form_fields.* from connect_patient_checkin_form_fields LEFT JOIN connect_form_ui_element ON connect_form_ui_element.room = connect_patient_checkin_form_fields.room_name where room_name = '" +
    req.params.roomAlias +
    "'";
  db.query(q, function (err, rows) {
    if (err) {
      logger.error(
        "api getCheckInFormFieldByRoom -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      return res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        res.status(200).json({
          status_code: 200,
          status_message: "all form fields",
          result: rows,
        });
      } else {
        res.status(200).json({
          status_code: 200,
          status_message: "no record found.",
          result: [],
        });
      }
    }
  });
};
/* ab--plivo make call api during video call---(030718) */
exports.plivoMakeNewCall = function (req, res) {
  if (req.body.languageId) {
    var language_id = req.body.languageId;
  } else {
    var language_id = null;
  }
  var userid = req.body.id;
  var phoneNumber = req.body.destNumber;
  var roomId = req.body.roomId;
  var sessionId = req.body.callSessionId;
  var token = req.body.token;
  const sipTokenData = `{"sip":true, "role":"client", "name":"'${phoneNumber}'"}`;
  const options = setSipOptions(roomId, phoneNumber);
  opentok.dial(
    sessionId,
    token,
    `sip:${phoneNumber}@sip.nexmo.com`,
    options,
    (error, sipCall) => {
      if (error) {
        logger.error(
          "api plivoMakeNewCall - Error -Message",
          error,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        var params = {};
        var checked_in = new Date();
        params.interpreter_start_time = moment(checked_in).format(
          "YYYY-MM-DD HH:mm:ss"
        ); //new Date();
        params.language_id = language_id;
        params.interpreter_used = 1;
        var sql = db.query(
          "UPDATE connect_call_log SET ? WHERE patient_id ='" +
            userid +
            "' AND sessionid = '" +
            sessionId +
            "'",
          params,
          function (err, rows, fields) {
            if (err) {
              logger.error(
                "api plivoMakeNewCall -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
            }
          }
        );
        app.set(phoneNumber, sipCall.connectionId);
        res.status(200).json({
          status_code: 200,
          status_message: "Call Dialed",
          result: sipCall,
        });
      }
    }
  );
};

exports.plivoCloseCall = function (req, res) {
  var sessionId = req.body.callSessionId;
  var connectionId = req.body.connectionId;
  console.log(req.body.callSessionId, req.body.connectionId);
  opentok.forceDisconnect(sessionId, connectionId, (error) => {
    if (error) {
      logger.error("api plivoCloseCall - Error -Message", error, "  :", __line);
      res.status(500).json({
        status_code: 500,
        status_message: "There was an error hanging up",
      });
    } else {
      var params = {};
      var checked_in = new Date();
      params.interpreter_end_time = moment(checked_in).format(
        "YYYY-MM-DD HH:mm:ss"
      ); //new Date();
      var sql = db.query(
        "UPDATE connect_call_log SET ? WHERE sessionid = '" + sessionId + "'",
        params,
        function (err, rows, fields) {
          if (err) {
            logger.error(
              "api plivoCloseCall -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "  :",
              __line
            );
          }
        }
      );
      res
        .status(200)
        .json({ status_code: 200, status_message: "Call Disconnect" });
    }
  });
};

