/* sendWCStaffNotification api start */
exports.sendWCStaffNotification = function (req, res) {
  logger.info("api sendWCStaffNotification doctor id", req.body.body.id);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api sendWCStaffNotification -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = { id: req.body.body.id };
      if (!params.id) {
        logger.error(
          'api sendWCStaffNotification -Error_Message -validation failed "id is required"   :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "invalid parameter or value passed",
        });
        return false;
      } else {
        var q = "select * from doctor where id = " + params.id;
        db.query(q, function (err, rows) {
          if (err) {
            logger.error(
              "api sendWCStaffNotification -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "  :",
              __line
            );
            res.status(500).json({
              status_code: 500,
              status_message: "internal server error",
            });
            return false;
          } else {
            if (rows.length > 0) {
              let phone = rows[0].phoneNo;
              SMSServer.messages.create(
                {
                  to: "+91" + phone,
                  from: config.app.smsFrom,
                  body: req.body.body.msgtext,
                },
                function (err, message) {
                  if (err) {
                    logger.error(
                      "api sendWCStaffNotification Error_Message :-",
                      err,
                      "  :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: "internal server error",
                    });
                    return false;
                  }
                  res.status(200).json({
                    status_code: 200,
                    status_message: "Notification sent successfully",
                  });
                }
              );
            } else {
              res
                .status(404)
                .json({ status_code: 404, status_message: "Data not found" });
            }
          }
        });
      }
    }
  });
};
/* sendWCStaffNotification api end */

exports.generateCallIdByPatientId = function (req, res) {
  logger.info(
    "api -- generateCallIdByPatientId patient id",
    req.body.patientId
  );
  if (
    req.body.patientId == "" ||
    req.body.patientId == undefined ||
    req.body.staffid == "" ||
    req.body.staffid == undefined
  ) {
    logger.error(
      'api generateCallIdByPatientId -Error_Message -validation failed "patientId,staffid is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = {
    patient_id: req.body.patientId,
    staff_id: req.body.staffid,
    call_started: req.body.call_started,
    call_type: req.body.call_type,
  };
  var checked_in = new Date();
  params.call_started = moment(checked_in).format("YYYY-MM-DD HH:mm:ss");
  var sql = db.query(
    "INSERT INTO patient_record SET ?",
    params,
    function (err, rows, fields) {
      if (err) {
        logger.error(
          "api generateCallIdByPatientId -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows) {
          var result = {};
          result.call_id = rows.insertId;
          result.staff_id = req.body.staffid;
          var data = {};
          var checked_in = new Date();
          data.patient_id = req.body.patientId;
          data.call_started = moment(checked_in).format("YYYY-MM-DD HH:mm:ss");
          data.checked_in = moment(checked_in).format("YYYY-MM-DD HH:mm:ss");
          data.patient_connected_at = moment(checked_in).format(
            "YYYY-MM-DD HH:mm:ss"
          );
          data.call_id = result.call_id;
          data.device_type = req.body.device_type;
          if (req.body.location_name) {
            data.call_location = req.body.location_name;
          } else {
            data.call_location = "";
          }
          data.room_name = req.body.room_name;
          data.appointmentId = req.body.appointmentId ? req.body.appointmentId : 0;
          var insertData = db.query(
            "INSERT INTO connect_call_log SET ?",
            data,
            function (err, rowsUpdated, fields) {
              if (err) {
                logger.error(
                  "api generateCallIdByPatientId -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (rowsUpdated) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "user added",
                    result: result,
                  });
                } else {
                  res.status(404).json({
                    status_code: 404,
                    status_message: "patient not found",
                  });
                }
              }
            }
          );
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "user not found" });
        }
      }
    }
  );
};
