exports.getUserCallDetails = function (req, res) {
  logger.info("api getUserCallDetails patient.id=", req.body.body.id);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api getUserCallDetails -Error_Message -validation failed "Authorization_Token is required"  :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = { id: req.body.body.id };
      if (!params.id || params.id == "" || params.id == undefined) {
        logger.error(
          'api getUserCallDetails -Error_Message -validation failed "id is required"   :',
          __line
        );
        res.status(400).json({
          status_code: 400,
          status_message: "invalid parameter or value passed",
        });
        return false;
      } else {
        var sql = db.query(
          "SELECT * FROM patient JOIN patientDetails ON patientDetails.patientId = patient.id JOIN connect_waiting_room ON patient.id = connect_waiting_room.patient_id WHERE connect_waiting_room.patient_id =" +
            params.id,
          params,
          function (err, rows, fields) {
            if (err) {
              logger.error(
                "api getUserCallDetails -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                res.status(200).json({
                  status_code: 200,
                  status_message: "user exists",
                  result: rows,
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "user not found" });
              }
            }
          }
        );
      }
    }
  });
};
/* doctor fetch user call data api end*/
