exports.updatestatusByPatientId = function (req, res) {
  logger.info("api updatestatusByPatientId patient_id =", req.body.patient_id);
  if (
    req.body.patient_id == "" ||
    req.body.patient_id == undefined ||
    req.body.status == "" ||
    req.body.status == undefined
  ) {
    logger.error(
      'api updatestatusByPatientId -Error_Message -validation failed "patient_id,status is required"  :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var query =
    "UPDATE connect_waiting_room SET status = '" +
    req.body.status +
    "' WHERE patient_id='" +
    req.body.patient_id +
    "'";
  db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api updatestatusByPatientId -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows) {
        socket.emit("onStatusChange", {
          call_id: null,
          mesage: "Status Changed",
          patient_id: req.body.patient_id,
        });
        res.status(200).json({
          status_code: 200,
          status_message: "successfully updated status",
          result: rows,
        });
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "id not found" });
      }
    }
  });
};
