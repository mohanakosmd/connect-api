exports.setPassword = function (req, res) {
  if (req.body.verifyType == "email") {
    logger.info("api setPassword email=", req.body.email);
    if (
      req.body.email == "" ||
      req.body.email == undefined ||
      req.body.otp == "" ||
      req.body.otp == undefined ||
      req.body.password == "" ||
      req.body.password == undefined
    ) {
      logger.error(
        'api setPassword -Error_Message -validation failed "email,otp,password is required"    :',
        __line
      );
      res.status(201).json({
        status_code: 201,
        status_message: "invalid parameter or value passed",
      });
      return false;
    }
    var params = {
      email: req.body.email,
      otp: req.body.otp,
      password: req.body.password,
      type: "forgot_password",
    };
    var query =
      "select * FROM verification_code where email ='" +
      params.email +
      "' And otp = '" +
      params.otp +
      "'And module = '" +
      params.type +
      "'";
    var sql = db.query(query, function (err, rows, fields) {
      if (err) {
        logger.error(
          "api setPassword -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "   :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows.length > 0) {
          var newquery =
            "select * FROM connect_provider where  email='" +
            params.email +
            "'";
          var sql = db.query(newquery, function (err, rows, fields) {
            if (err) {
              logger.error(
                "api setPassword -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "   :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                var resultset = rows;
                var query1 =
                  "UPDATE connect_provider SET password = '" +
                  crypto
                    .createHash("md5")
                    .update(params.password)
                    .digest("hex") +
                  "' WHERE email='" +
                  params.email +
                  "'";
                var sql = db.query(query1, function (err, rows, fields) {
                  if (err) {
                    logger.error(
                      "api setPassword -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "  :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: "internal server error",
                    });
                  } else {
                    if (rows) {
                      async.parallel(
                        [
                          function (callback) {
                            if (resultset[0].staff_id > 0) {
                              var newquerystaff =
                                "UPDATE staff SET password = '" +
                                crypto
                                  .createHash("md5")
                                  .update(params.password)
                                  .digest("hex") +
                                "' WHERE id='" +
                                resultset[0].staff_id +
                                "'";
                              var sql = db.query(
                                newquerystaff,
                                function (err, rows, fields) {
                                  if (err) {
                                    logger.error(
                                      "api setPassword -Error_Code :-",
                                      err.code,
                                      "Error_Message :-",
                                      err.sqlMessage,
                                      "  :",
                                      __line
                                    );
                                    res.status(500).json({
                                      status_code: 500,
                                      status_message: "internal server error",
                                      error: err,
                                    });
                                  }
                                  return callback(null, rows);
                                }
                              );
                            } else {
                              return callback(null, rows);
                            }
                          },
                          function (callback) {
                            if (resultset[0].doctor_id > 0) {
                              var newquerydoctor =
                                "UPDATE doctor SET password = '" +
                                crypto
                                  .createHash("md5")
                                  .update(params.password)
                                  .digest("hex") +
                                "' WHERE id='" +
                                resultset[0].doctor_id +
                                "'";
                              var sql = db.query(
                                newquerydoctor,
                                function (err, rows, fields) {
                                  if (err) {
                                    logger.error(
                                      "api setPassword -Error_Code :-",
                                      err.code,
                                      "Error_Message :-",
                                      err.sqlMessage,
                                      "  :",
                                      __line
                                    );
                                    res.status(500).json({
                                      status_code: 500,
                                      status_message: "internal server error",
                                    });
                                  } else {
                                    return callback(null, rows);
                                  }
                                }
                              );
                            } else {
                              return callback(null, rows);
                            }
                          },
                        ],
                        function (err, result) {
                          if (err) {
                            console.log(err);
                          } else {
                            res.status(200).json({
                              status_code: 200,
                              status_message: "user added",
                              result: rows[0],
                            });
                          }
                        }
                      );
                    } else {
                      res.status(404).json({
                        status_code: 404,
                        status_message: "user not found",
                      });
                    }
                  }
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "user not found" });
              }
            }
          });
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "user not found" });
        }
      }
    });
  }
  if (req.body.verifyType == "phone") {
    logger.info("api setPassword phoneNo=", req.body.phoneNo);
    if (
      req.body.phoneNo == "" ||
      req.body.phoneNo == undefined ||
      req.body.otp == "" ||
      req.body.otp == undefined ||
      req.body.password == "" ||
      req.body.password == undefined
    ) {
      logger.error(
        'api setPassword -Error_Message -validation failed "phoneNo,otp,password is required"   :',
        __line
      );
      res.status(201).json({
        status_code: 201,
        status_message: "invalid parameter or value passed",
      });
      return false;
    }
    var params = {
      phoneNo: req.body.phoneNo,
      otp: req.body.otp,
      password: req.body.password,
      type: "forgot_password",
    };
    var query =
      "select * FROM verification_code where mobile_number ='" +
      params.phoneNo +
      "' And otp = '" +
      params.otp +
      "'And module = '" +
      params.type +
      "'";
    var sql = db.query(query, function (err, rows, fields) {
      if (err) {
        logger.error(
          "api setPassword -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows.length > 0) {
          var newquery =
            "select  *  FROM connect_provider where  phoneNo='" +
            params.phoneNo +
            "'";
          var sql = db.query(newquery, function (err, rows, fields) {
            if (err) {
              logger.error(
                "api setPassword -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                var resultset = rows;
                var query1 =
                  "UPDATE connect_provider SET password = '" +
                  crypto
                    .createHash("md5")
                    .update(params.password)
                    .digest("hex") +
                  "' WHERE phoneNo='" +
