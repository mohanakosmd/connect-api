    speciality_type: "Occupational Health Clinic",
    city: exceldatarefral[index]["city"],
    state: exceldatarefral[index]["state"],
    zip: exceldatarefral[index]["zip"],
    location_type: exceldatarefral[index]["type"] || "OTHER",
    email: "",
    phone: exceldatarefral[index]["phone"],
    fax: exceldatarefral[index]["fax"],
    preferred_referral_method: "phone",
    hours_of_operation: "",
    notes: exceldatarefral[index]["notes"],
  };
  if (flag) {
    if (
      params.speciality_type != "" &&
      params.city != "" &&
      params.state != "" &&
      params.zip != "" &&
      params.phone != ""
    ) {
      db.query(
        "UPDATE wc_referrals SET ? WHERE id =" + referral_id + "",
        params,
        function (err, rowsupdae, fields) {
          if (err) {
            insertandupdatereferralfors1medical(
              exceldatarefral,
              index,
              params.employer_id,
              params.wc_location_id,
              true,
              res,
              referral_id
            );
          } else {
            if (rowsupdae) {
              findlocationfors1medical(
                exceldatarefral,
                index + 1,
                params.employer_id,
                res
              );
            } else {
              insertandupdatereferralfors1medical(
                exceldatarefral,
                index,
                params.employer_id,
                params.wc_location_id,
                true,
                res,
                referral_id
              );
            }
          }
        }
      );
    } else {
      findlocationfors1medical(
        exceldatarefral,
        index + 1,
        params.employer_id,
        res
      );
    }
  } else {
    if (
      params.speciality_type != "" &&
      params.city != "" &&
      params.state != "" &&
      params.zip != "" &&
      params.phone != ""
    ) {
      db.query(
        "INSERT INTO wc_referrals SET ?",
        params,
        function (err, rows, fields) {
          if (err) {
            insertandupdatereferralfors1medical(
              exceldatarefral,
              index,
              params.employer_id,
              params.wc_location_id,
              false,
              res
            );
          } else {
            if (rows) {
              findlocationfors1medical(
                exceldatarefral,
                index + 1,
                params.employer_id,
                res
              );
            } else {
              insertandupdatereferralfors1medical(
                exceldatarefral,
                index,
                params.employer_id,
                params.wc_location_id,
                false,
                res
              );
            }
          }
        }
      );
    } else {
      findlocationfors1medical(
        exceldatarefral,
        index + 1,
        params.employer_id,
        res
      );
    }
  }
};
/**********************end********************/
/* check if client url valid or not api start */
exports.validClientUrl = function (req, res) {
  logger.info("api -- validClientUrl uuid/id", req.body.id);
  var params = {
    id: req.body.id,
    transactionId: req.body.transactionId,
    alias: req.body.alias,
  };
  if (!params.id) {
    logger.error(
      'api validClientUrl -Error_Message -validation failed "id,transactionId is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
  } else {
    if (params.alias.toLowerCase().indexOf("akoslive") != -1) {
      // var query = 'select * from akoslive_payments where akoslive_payments.transaction_id = \'' + params.transactionId + '\'';
      // db.query(query, function (err, rows) {
      // if (err) {
      // 	logger.error('api validClientUrl -Error_Code :-',err.code,'Error_Message :-',err.sqlMessage,'  :',__line);
      // 	res.status(500).json({ "status_code": 500, "status_message": "internal server error" });
      // } else {
      // if (rows.length > 0) {
      if (
        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
          params.id
        )
      ) {
        var query = "select * from patient  where uuid = '" + params.id + "'";
      } else {
        var query = "select * from patient  where id = '" + params.id + "'";
      }
      db.query(query, function (err, rows) {
        if (err) {
          logger.error(
            "api validClientUrl -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          if (rows.length > 0) {
            getJwtAuthToken(
              rows[0].uuid,
              "patient-app",
              function (err, callbackresult) {
                if (err) {
                  res
                    .status(401)
                    .json({ status_code: 401, status_message: errorAuthToken });
                } else if (callbackresult.status_code == 200) {
                  rows[0].access_token = callbackresult.data.access_token;
                  res.status(200).json({
                    status_code: 200,
                    status_message: "valid patient",
                    result: rows[0],
                  });
                }
              }
            );
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "invalid patient" });
          }
        }
      });
      // } else {
      // 	res.status(404).json({ "status_code": 404, "status_message": "invalid transactionId" });
      // }
      // }
      // })
    } else {
      var query = "select * from patient  where uuid = '" + params.id + "'";
      db.query(query, function (err, rows) {
        if (err) {
          logger.error(
            "api validClientUrl -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          if (rows.length > 0) {
            if (req.body.auto && req.body.auto == 1) {
              getJwtAuthToken(
                rows[0].uuid,
                "patient-app",
                function (err, callbackresult) {
                  if (err) {
                    res.status(401).json({
                      status_code: 401,
                      status_message: errorAuthToken,
                    });
                  } else if (callbackresult.status_code == 200) {
                    rows[0].access_token = callbackresult.data.access_token;
                    res.status(200).json({
                      status_code: 200,
                      status_message: "valid patient",
                      result: rows[0],
                    });
                  }
                }
              );
            } else {
              var query =
                "select id from payment where transaction_id = '" +
                params.transactionId +
                "' AND patient_id='" +
                rows[0].id +
                "'";
              db.query(query, function (err, rows1) {
                if (err) {
                  logger.error(
                    "api validClientUrl -Error_Code :-",
                    err.code,
                    "Error_Message :-",
                    err.sqlMessage,
                    "  :",
                    __line
                  );
                  res.status(500).json({
                    status_code: 500,
                    status_message: "internal server error",
                  });
                } else {
                  if (rows1.length > 0) {
                    getJwtAuthToken(
                      rows[0].uuid,
                      "patient-app",
                      function (err, callbackresult) {
                        if (err) {
                          res.status(401).json({
                            status_code: 401,
                            status_message: errorAuthToken,
                          });
                        } else if (callbackresult.status_code == 200) {
                          rows[0].access_token =
                            callbackresult.data.access_token;
                          res.status(200).json({
                            status_code: 200,
                            status_message: "valid patient",
                            result: rows[0],
                          });
                        }
                      }
                    );
                  } else {
                    res.status(404).json({
                      status_code: 404,
                      status_message: "invalid transactionId",
                    });
                  }
                }
              });
            }
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "invalid patient" });
          }
        }
      });
    }
  }
};
exports.getLocationDetailByTransactionId = function (req, res) {
  logger.info(
    "api getLocationDetailByTransactionId transactionId",
    req.body.transactionId
  );
  var params = { transactionId: req.body.transactionId };
  if (
    !params.transactionId ||
    params.transactionId == undefined ||
    params.transactionId == ""
  ) {
    logger.error(
      'api getLocationDetailByTransactionId -Error_Message -validation failed "transactionId is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
  } else {
    var query =
      "select * from akoslive_eligibility_checks where akoslive_eligibility_checks.transaction_id = '" +
      params.transactionId +
      "'";
    db.query(query, function (err, rows) {
      if (err) {
        logger.error(
          "api getLocationDetailByTransactionId -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows.length > 0) {
          var eligibilityCheckRequest = JSON.parse(
            rows[0].eligibility_check_request
          );
          if (
            eligibilityCheckRequest.locationId &&
            eligibilityCheckRequest.locationId != undefined &&
            eligibilityCheckRequest.locationId != ""
          ) {
            var location_id = eligibilityCheckRequest.locationId;
            var query =
              "select location_name from akoslive_pricing  where location_id = '" +
              location_id +
              "'";
            db.query(query, function (err, rows) {
              if (err) {
                logger.error(
                  "api getLocationDetailByTransactionId -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (rows.length > 0) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "valid patient",
                    result: rows[0],
                  });
                } else {
                  res.status(404).json({
                    status_code: 404,
                    status_message: "location Id not found",
                  });
                }
              }
            });
          } else {
            res.status(404).json({
              status_code: 404,
              status_message: "Eligibility not set",
            });
          }
        } else {
          res.status(404).json({
            status_code: 404,
            status_message: "TransactionId not found",
          });
        }
      }
    });
  }
};
