                                "' WHERE id='" +
                                resultset[0].staff_id +
                                "'";
                              var sql = db.query(
                                newquerystaff,
                                function (err, rows, fields) {
                                  if (err) {
                                    logger.error(
                                      "api setPassword -Error_Code :-",
                                      err.code,
                                      "Error_Message :-",
                                      err.sqlMessage,
                                      "  :",
                                      __line
                                    );
                                    res.status(500).json({
                                      status_code: 500,
                                      status_message: "internal server error",
                                    });
                                  }
                                  return callback(null, rows);
                                }
                              );
                            } else {
                              return callback(null, rows);
                            }
                          },
                          function (callback) {
                            if (resultset[0].doctor_id > 0) {
                              var newquerydoctor =
                                "UPDATE doctor SET password = '" +
                                crypto
                                  .createHash("md5")
                                  .update(params.password)
                                  .digest("hex") +
                                "' WHERE id='" +
                                resultset[0].doctor_id +
                                "'";
                              var sql = db.query(
                                newquerydoctor,
                                function (err, rows, fields) {
                                  if (err) {
                                    logger.error(
                                      "api setPassword -Error_Code :-",
                                      err.code,
                                      "Error_Message :-",
                                      err.sqlMessage,
                                      "  :",
                                      __line
                                    );
                                    res.status(500).json({
                                      status_code: 500,
                                      status_message: "internal server error",
                                    });
                                  } else {
                                  }
                                }
                              );
                            } else {
                              return callback(null, rows);
                            }
                          },
                        ],
                        function (err, result) {
                          if (err) {
                            console.log(err);
                          } else {
                            res.status(200).json({
                              status_code: 200,
                              status_message: "user added",
                              result: rows[0],
                            });
                          }
                        }
                      );
                    } else {
                      res.status(404).json({
                        status_code: 404,
                        status_message: "user not found",
                      });
                    }
                  }
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "user not found" });
              }
            }
          });
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "user not found" });
        }
      }
    });
  }
};
