exports.getPatientSubscribePlanConfig = function (req, res) {
  logger.info("api getPatientSubscribePlanConfig");
  if (!req.params.id || req.params.id == "" || req.params.id == undefined) {
    logger.error(
      'api getPatientSubscribePlanConfig -Error_Message -validation failed "patient id  is required"   :',
      __line
    );
    res.status(400).json({
      status_code: 400,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var query =
    "SELECT member_pricing_engine.id,member_pricing_engine.consult_fee FROM patient JOIN subscribed_patient ON (subscribed_patient.patient_id=patient.id AND auto_renew = 1) JOIN member_pricing_engine ON member_pricing_engine.id=patient.member_pricing_engine_id where patient.id =" +
    req.params.id;
  db.query(query, function (err, rows) {
    if (err) {
      logger.error(
        "api getPatientSubscribePlanConfig -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        res.status(200).json({
          status_code: 200,
          status_message: "patient have subscribe a plan",
          result: rows[0],
        });
      } else {
        res.status(404).json({
          status_code: 404,
          status_message: "you don't have any paln",
        });
      }
    }
  });
};
