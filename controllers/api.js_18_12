/* add user to waiting room api */
exports.addUserToWaiting = function (req, res) {
  logger.info("api  addUserToWaiting patient_id", req.body.userId);
  var params = { patient_id: req.body.userId };
  if (params.patient_id == "") {
    logger.error(
      'api addUserToWaiting -Error_Message -validation failed "id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
      res: params,
      abc: "test",
    });
    return false;
  } else {
    // [ 'Vishal61', 'TarunKumar' ]
    const roomAliases = req.body.alias;
    
    roomAliases.map((roomName, index) => {
      console.log(roomName, 'roomName===');
      sendCallByPlivo(roomName);
    });  

    if (req.body.groupId == 0) {
      params.pcp_doctor_id = req.body.docId;
    } else {
      params.pcp_doctor_id = 0;
    }
    var sql1 = db.query(
      "SELECT id FROM connect_waiting_room WHERE patient_id=" +
        params.patient_id,
      params,
      function (err, rows, fields) {
        if (err) {
          logger.error(
            "api addUserToWaiting -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
          return false;
        } else {
          //if Patient is already in Patient Room
          if (rows.length > 0) {
            getOpenTokCallback(function (err, resultOpentok) {
              if (resultOpentok.status_code == 200) {
                params.session = resultOpentok.result[0].session;
                params.token = resultOpentok.result[0].token;
                var checked_in = new Date();
                params.checked_in = moment(checked_in).format(
                  "YYYY-MM-DD HH:mm:ss"
                ); //new Date();
                params.pcp_doctor_id = req.body.docId;
                params.group_id = req.body.groupId;
                params.pcp_medication = req.body.medication;
                params.pcp_medical_condition = req.body.medical_condition;
                params.pcp_allergy = req.body.allergy;
                params.pcp_symptom = req.body.symptom;
                params.state_of_injury = req.body.state_of_injury;
                params.employer_name = req.body.employer_name;
                params.archive_id = "";
                if (req.body.date_of_injury && req.body.date_of_injury != "") {
                  params.date_of_injury = moment(
                    req.body.date_of_injury
                  ).format("YYYY-MM-DD HH:mm:ss");
                }
                if (req.body.call_id) {
                  params.call_id = req.body.call_id;
                }
                var sql = db.query(
                  "UPDATE connect_waiting_room SET ? WHERE patient_id =" +
                    params.patient_id +
                    "",
                  params,
                  function (err, rows, fields) {
                    if (err) {
                      logger.error(
                        "api addUserToWaiting -Error_Code :-",
                        err.code,
                        "Error_Message :-",
                        err.sqlMessage,
                        "  :",
                        __line
                      );
                      res.status(201).json({
                        status_code: 201,
                        status_message: "invalid parameter or value passed",
                      });
                      return false;
                    } else {
                      if (rows) {
                        var inviteData = {};
                        inviteData.session_id = resultOpentok.result[0].session;
                        inviteData.token = resultOpentok.result[0].token;
                        if (params.call_id) {
                          inviteData.call_id = params.call_id;
                        }
                        inviteData.invite_id =
                          randomValueBase64(6).toUpperCase();
                        var sql = db.query(
                          "INSERT INTO connect_thirdparty_url SET ?",
                          inviteData,
                          function (err, rows, fields) {
                            if (err) {
                              logger.error(
                                "api addUserToWaiting -Error_Code :-",
                                err.code,
                                "Error_Message :-",
                                err.sqlMessage,
                                "  :",
                                __line
                              );
                              res.status(500).json({
                                status_code: 500,
                                status_message: "internal server error",
                              });
                              return false;
                            } else {
                              db.query(
                                "UPDATE connect_call_log SET sessionid = '" +
                                  inviteData.session_id +
                                  "',token = '" +
                                  inviteData.token +
                                  "' WHERE call_id =" +
                                  inviteData.call_id,
                                function (err, rowsupdae, fields) {
                                  if (err) {
                                    logger.error(
                                      "api addUserToWaiting -Error_Code :-",
                                      err.code,
                                      "Error_Message :-",
                                      err.sqlMessage,
                                      "  :",
                                      __line
                                    );
                                    res.status(200).json({
                                      status_code: 200,
