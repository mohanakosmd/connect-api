exports.updatedataBycallId = function (req, res) {
  logger.info("api updatedataBycallId call_id ", req.body.call_id);
  if (req.body.call_id == "" || req.body.call_id == undefined) {
    logger.error(
      'api updatedataBycallId -Error_Message -validation failed "call_id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = {
    medications: req.body.medication,
    allergies: req.body.allergy,
    symptoms: req.body.symptom,
    medical_conditions: req.body.medical_condition,
  };
  var query =
    "UPDATE patient_record SET medications = '" +
    params.medications +
    "', symptoms = '" +
    params.symptoms +
    "', medical_conditions = '" +
    params.medical_conditions +
    "', allergies = '" +
    params.allergies +
    "' WHERE id='" +
    req.body.call_id +
    "'";
  db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api updatedataBycallId -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows) {
        res.status(200).json({
          status_code: 200,
          status_message: "successfully updated data",
          result: rows,
        });
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "id not found" });
      }
    }
  });
};
/* update data by callId api end*/

/* update doctor Id by call Id api(07132018)*/
exports.updateDoctorIdBycallId = function (req, res) {
  logger.info("api updateDoctorIdBycallId call_id", req.body.call_id);
  if (req.body.call_id == "" || req.body.call_id == undefined) {
    logger.error(
      'api updateDoctorIdBycallId -Error_Message -validation failed "call_id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = {
    doctor_id: req.body.docId,
    call_id: req.body.call_id,
    doctor_call_respond: req.body.doctor_call_respond,
  };
  var checked_in = new Date();
  params.doctor_call_start_at = moment(checked_in).format(
    "YYYY-MM-DD HH:mm:ss"
  );
  var query =
    "UPDATE patient_record SET doctor_id = '" +
    params.doctor_id +
    "', doctor_call_respond = '" +
    params.doctor_call_respond +
    "', call_completed_by_doctor	 = 1,is_completed = 1, doctor_call_start_at ='" +
    params.doctor_call_start_at +
    "' WHERE id='" +
    req.body.call_id +
    "'";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api updateDoctorIdBycallId -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else if (rows) {
      var query =
        "UPDATE connect_call_log SET provider_connected_at ='" +
        params.doctor_call_start_at +
        "' WHERE call_id='" +
        req.body.call_id +
        "'";
      var sql = db.query(query, function (err, rows1, fields) {
        if (err) {
          logger.error(
            "api updateDoctorIdBycallId -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else if (rows1) {
          res.status(200).json({ status_code: 200, status_message: "updated" });
        }
      });
    }
  });
};
exports.getPatientImageUrl = function (req, res) {
  logger.info("api getPatientImageUrl callId", req.body.callId);
  var params = { callId: req.body.callId };
  if (!params.callId) {
    logger.error(
      'api getPatientImageUrl -Error_Message -validation failed "callId is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "inavlid parameter or value passed",
    });
    return false;
  }
  var q = "select * from patient_record where id = " + params.callId;
  db.query(q, function (err, rows) {
    if (rows && rows.length > 0) {
      res.status(200).json({
        status_code: 200,
        status_message: "Imageurl featched successfully",
        result: rows,
      });
    } else {
      res
        .status(404)
        .json({ status_code: 404, status_message: "Imageurl not found" });
    }
  });
};

exports.getWaitingUserList = function (req, res) {
  // logger.info('api getWaitingUserList provider id', req.body.body.id);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api getWaitingUserList -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = { id: req.body.body.id, group_id: req.body.body.group_id };
      if (params.id == "") {
        logger.error(
          'api getWaitingUserList -Error_Message -validation failed "id is required"   :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "invalid parameter or value passed",
        });
        return false;
      } else {
        if (params.group_id.length == 1 && params.group_id[0].id == 0) {
          var sql = db.query(
            "SELECT connect_thirdparty_url.invite_id, patientDetails.age, patient.gender,patient.dateofbirth,patient.first_name,patient.last_name,patient.city,patient.state,patient.phone,patient.name,connect_waiting_room.group_id,connect_waiting_room.employer_name,connect_waiting_room.checked_in,connect_waiting_room.patient_id ,connect_waiting_room.status,connect_waiting_room.call_id,connect_waiting_room.pcp_doctor_id,connect_call_log.call_location FROM connect_waiting_room JOIN connect_thirdparty_url ON connect_thirdparty_url.call_id = connect_waiting_room.call_id JOIN  connect_call_log ON connect_call_log.call_id = connect_waiting_room.call_id JOIN patient ON patient.id = connect_waiting_room.patient_id JOIN patientDetails ON patientDetails.patientId = patient.id WHERE ((connect_waiting_room.group_id = 0 AND  connect_waiting_room.pcp_doctor_id =" +
              params.id +
              ') AND (connect_waiting_room.status = "waiting" OR  connect_waiting_room.status = "In progress" OR  connect_waiting_room.status = "PENDING" OR  connect_waiting_room.status = "IN CONSULTATION")AND connect_waiting_room.checked_in > date_sub(now(), interval ' +
              config.waiting_list_duration +
              " HOUR))",
            params,
            function (err, rows, fields) {
              if (err) {
                logger.error(
                  "api getWaitingUserList -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (rows) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "user exists",
                    result: rows,
                  });
                } else {
                  res.status(404).json({
                    status_code: 404,
                    status_message: "user not found",
                  });
                }
              }
            }
          );
        } else {
          params.groupid = "";
          for (var i = 0; i < params.group_id.length; i++) {
            params.groupid = params.groupid + params.group_id[i].id;
            if (i != params.group_id.length - 1) {
              params.groupid = params.groupid + ",";
            }
          }
          var sql = db.query(
            "SELECT patient.gender, patientDetails.age, patient.dateofbirth,patient.first_name,patient.last_name,patient.city,patient.state,patient.phone,patient.name,connect_waiting_room.group_id,connect_waiting_room.employer_name,connect_waiting_room.checked_in,connect_waiting_room.patient_id ,connect_waiting_room.status,connect_waiting_room.call_id,connect_waiting_room.pcp_doctor_id,connect_provider.name,connect_call_log.call_location,patient_record.call_type,connect_thirdparty_url.invite_id FROM connect_waiting_room JOIN  connect_call_log ON connect_call_log.call_id = connect_waiting_room.call_id JOIN  patient ON patient.id = connect_waiting_room.patient_id LEFT JOIN connect_provider ON connect_waiting_room.pcp_doctor_id = connect_provider.id JOIN patient_record ON patient_record.id = connect_waiting_room.call_id JOIN connect_thirdparty_url ON connect_thirdparty_url.call_id = connect_waiting_room.call_id JOIN patientDetails ON patientDetails.patientId = patient.id WHERE ((connect_waiting_room.group_id IN (" +
              params.groupid +
              '))AND(connect_waiting_room.status = "waiting" OR  connect_waiting_room.status = "In progress" OR connect_waiting_room.status = "PENDING" OR  connect_waiting_room.status = "IN CONSULTATION")AND connect_waiting_room.checked_in > date_sub(now(), interval ' +
              config.waiting_list_duration +
              " HOUR))",
            params,
            function (err, rows, fields) {
              console.log(rows);
              if (err) {
                logger.error(
                  "api getWaitingUserList -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (rows) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "user exists",
                    result: rows,
                  });
                } else {
                  res.status(404).json({
                    status_code: 404,
                    status_message: "user not found",
                  });
                }
              }
            }
          );
        }
      }
    }
  });
};

exports.getUserEmails = function (req, res) {
  logger.info("api getUserEmails email/phone", req.body.email);
  if (
    req.body.email == "" ||
    req.body.email == undefined ||
    req.body.type == "" ||
    req.body.type == undefined
  ) {
    logger.error(
      'api getUserEmails -Error_Message -validation failed "email,type is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var params = { email: req.body.email, type: req.body.type };
  var query = "";
  if (params.type == "doctor") {
    query =
      "select id,name,email,phoneNo,uuid from doctor where email ='" +
      params.email +
      "'";
  } else if (params.type == "patient") {
    query =
      "select id,first_name,last_name,email,phone,uuid from patient where email ='" +
      params.email +
      "'";
  } else if (params.type == "staff") {
    query =
      "select id,first_name,last_name,email,uuid FROM staff where email ='" +
      params.email +
      "'";
  } else if (params.type == "provider") {
    query =
      "select id,name,email,phoneNo,uuid FROM connect_provider where email ='" +
      params.email +
      "'";
  }
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api getUserEmails -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        res.status(200).json({
          status_code: 200,
          status_message: "user added",
          result: rows[0],
        });
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "user not found" });
      }
    }
  });
};

/* send otp in case of forgot password*/
exports.forgotsendOTP = function (req, res) {
  logger.info("api forgotsendOTP email", req.body.email);
  var params = {
    id: req.body.id,
    email: req.body.email,
    name: req.body.name,
    phoneNo: req.body.phoneNo,
    verifyType: req.body.verifyType,
  };
  if (
    params.email == "" ||
    params.email == undefined ||
    params.name == "" ||
    params.name == undefined
  ) {
    logger.error(
      'api forgotsendOTP -Error_Message -validation failed "email,name is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    let ipAddress =
      (
        req.headers["X-Forwarded-For"] ||
        req.headers["x-forwarded-for"] ||
        ""
      ).split(",")[0] || req.client.remoteAddress;
    var getverifyMinQuery =
      "SELECT * FROM `verification_code` WHERE (`email`='" +
      params.email +
      "' or `mobile_number`= '" +
      params.phoneNo +
      "') AND `created_at` > date_sub(now(), interval '" +
      config.twilio.restrictotptime +
      "' SECOND) AND origin ='" +
      "Akos Connect" +
      "' AND received_mode ='" +
      params.verifyType +
      "'";
    db.query(getverifyMinQuery, function (err, selectrows, fields) {
      if (err) {
        logger.error(
          "api forgotsendOTP -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
        return false;
      } else {
        if (selectrows.length > 0) {
          res
            .status(429)
            .json({ status_code: 429, status_message: "Too many attempts" });
          return false;
        } else {
          var docIDData = {};
          docIDData.doc_id = params.id;
          var otpParam = {};
          var expireMinutes = 30;
          var curDate = moment().format("YYYY-MM-DD HH:mm:ss");
          var expiredTime = moment(curDate)
            .add(expireMinutes, "minutes")
            .format("YYYY-MM-DD HH:mm:ss");
          var generatedOTP = Math.floor(Math.random() * 900000) + 100000;
          otpParam.received_mode = params.verifyType;
          otpParam.origin = "Akos Connect";
          otpParam.otp = generatedOTP;
          otpParam.expiry_timestamp = expiredTime;
          otpParam.module = "forgot_password";
          otpParam.created_at = curDate;
          var docName = req.body.name;
          otpParam.mobile_number = params.phoneNo;
          otpParam.email = params.email;
          otpParam.ip_address = ipAddress;
          if (params.verifyType == "phone") {
            otpParam.mobile_number = params.phoneNo;
            otpParam.email = params.email;
            SMSServer.messages.create(
              {
                to: "+91" + params.phoneNo,
                from: config.app.smsFrom,
                body:
                  "Your account verification code for Akos Connect is " +
                  otpParam.otp +
                  ". It expires after " +
                  expireMinutes +
                  " minutes.",
              },
              function (err, message) {
                if (err) {
                  logger.error(
                    "api forgotsendOTP Error_Message :-",
                    err,
                    "  :",
                    __line
                  );
                  res.status(500).json({
                    status_code: 500,
                    status_message: "internal server error",
                  });
                } else {
                  var sql = db.query(
                    "INSERT INTO verification_code SET ? ",
                    otpParam,
                    function (err, rows, fields) {
                      if (err) {
                        logger.error(
                          "api forgotsendOTP -Error_Code :-",
                          err.code,
                          "Error_Message :-",
                          err.sqlMessage,
                          "  :",
                          __line
                        );
                        res.status(500).json({
                          status_code: 500,
                          status_message: "internal server error",
                        });
                      } else {
                        if (rows) {
                          res.status(200).json({
                            status_code: 200,
                            status_message: "OTP sent successfully",
                            result: docIDData,
                          });
                        } else {
                          res.status(404).json({
                            status_code: 404,
                            status_message: "not found",
                          });
                        }
                      }
                    }
                  );
                }
              }
            );
          } else if (params.verifyType == "email") {
            var msg = {
              to: params.email,
              from: config.app.mailSender,
              subject: "AkosConnect Verification Code",
              html:
                '\
													<p>Hello there: </p>\
													<p style="margin-bottom: 1px;">Your account verification code for the AkosConnect video conference with  ' +
                docName +
                " is: " +
                otpParam.otp +
                " <br><br>\
													<p>Thank you,</p>\
													<p " +
                docName,
            };
            mailServer.send(msg, function () {
              var sql = db.query(
                "INSERT INTO verification_code SET ? ",
                otpParam,
                function (err, rows, fields) {
                  if (err) {
                    logger.error(
                      "api forgotsendOTP -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "  :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: "internal server error",
                    });
                  } else {
                    if (rows) {
                      res.status(200).json({
                        status_code: 200,
                        status_message: "OTP sent successfully",
                        result: docIDData,
                      });
                    } else {
                      res.status(404).json({
                        status_code: 404,
                        status_message: "not found",
                      });
                    }
                  }
                }
              );
            });
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "not found" });
          }
        }
      }
    });
  }
};

exports.updatedoctorid = function (req, res) {
  logger.info("api updatedoctorid patient id", req.body.patientid);
  var paramswaiting = {
    patient_id: req.body.patientid,
    pcp_doctor_id: req.body.docid,
    group_id: req.body.groupid,
  };
  if (
    !paramswaiting.patient_id ||
    paramswaiting.patient_id == undefined ||
    paramswaiting.pcp_doctor_id == undefined
  ) {
    logger.error(
      'api updatedoctorid -Error_Message -validation failed "patientid,docid is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var query =
      "UPDATE connect_waiting_room SET pcp_doctor_id = '" +
      paramswaiting.pcp_doctor_id +
      "', group_id = '" +
      paramswaiting.group_id +
      "' WHERE patient_id=" +
      paramswaiting.patient_id;
    db.query(query, function (err, rows, fields) {
      if (err) {
        logger.error(
          "api updatedoctorid -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows) {
          var cstarttime = moment(new Date()).format("YYYY-MM-DD HH:mm:ss");
          var query =
            "UPDATE connect_call_log SET doctor_id = " +
            req.body.docid +
            ",call_started = '" +
            cstarttime +
            "',nurse_connected_at = '" +
            cstarttime +
            "' WHERE call_id= " +
            req.body.callid;
          db.query(query, function (err, rows, fields) {
            if (err) {
              logger.error(
                "api updatedoctorid -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                var selectDocIdQuery =
                  "SELECT doctor_id, staff_id from connect_provider where id = '" +
                  req.body.docid +
                  "'";
                db.query(selectDocIdQuery, function (err, rows, fields) {
                  if (err) {
                    logger.error(
                      "api updatedoctorid -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "  :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message:
                        "Error while selecting doctor_id and staff_id",
                    });
                  } else if (rows) {
                    var doc_call_started_at = moment(new Date()).format(
                      "YYYY-MM-DD HH:mm:ss"
                    );
                    var query =
                      "UPDATE patient_record SET doctor_id = '" +
                      rows[0].doctor_id +
                      "', staff_id = '" +
                      rows[0].staff_id +
                      "', doctor_call_respond = '1',doctor_call_start_at = '" +
                      doc_call_started_at +
                      "' WHERE id='" +
                      req.body.callid +
                      "'";
                    db.query(query, function (err, rows, fields) {
                      if (err) {
                        logger.error(
                          "api updatedoctorid -Error_Code :-",
                          err.code,
                          "Error_Message :-",
                          err.sqlMessage,
                          "  :",
                          __line
                        );
                        res.status(500).json({
                          status_code: 500,
                          status_message: "internal server error",
                        });
                      } else if (rows) {
                        res.status(200).json({
                          status_code: 200,
                          status_message: "updated",
                        });
                      }
                    });
                  }
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "id not found" });
              }
            }
          });
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "doctor not found" });
        }
      }
    });
  }
};
exports.thirdpartycalldisconnect = function (req, res) {
  logger.info(
    "api thirdpartycalldisconnect call disconnect time call id",
    req.body.callid
  );
  if (!req.body.callid || req.body.callid == undefined) {
    logger.error(
      'api thirdpartycalldisconnect -Error_Message -validation failed "callid is required"   :',
      __line
    );
    res.status(400).json({
      status_code: 400,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var cstarttime = moment(new Date()).format("YYYY-MM-DD HH:mm:ss");
    if (!req.body.phoneNo || req.body.phoneNo == undefined) {
      var query =
        "UPDATE connect_call_log SET thirdparty_disconnected_at = '" +
        cstarttime +
        "' WHERE call_id= '" +
        req.body.callid +
        "'";
    } else {
      var query =
        "UPDATE connect_call_log SET provider_disconnected_at = '" +
        cstarttime +
        "' WHERE call_id= '" +
        req.body.callid +
        "'";
    }
    db.query(query, function (err, rows, fields) {
      if (err) {
        logger.error(
          "api thirdpartycalldisconnect -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows) {
          res.status(200).json({ status_code: 200, status_message: "updated" });
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "callid not found" });
        }
      }
    });
  }
};
exports.callendbypatient = function (req, res) {
  logger.info("api callendbypatient callid", req.body.callid);
  var checked_in = new Date();
  var params = {
    call_id: req.body.callid,
    callendtime: moment(checked_in).format("YYYY-MM-DD HH:mm:ss"),
  };
  var query =
    "UPDATE patient_record SET call_ended = '" +
    params.callendtime +
    "' WHERE id='" +
    params.call_id +
    "'";
  db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api callendbypatient -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else if (rows) {
      var query =
        "UPDATE connect_call_log SET call_ended = '" +
        params.callendtime +
        "',patient_disconnected_at = '" +
        params.callendtime +
        "' WHERE call_id='" +
        params.call_id +
        "'";
      db.query(query, function (err, rowsupdate, fields) {
        if (err) {
          logger.error(
            "api callendbypatient -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else if (rowsupdate) {
          var query =
          "UPDATE connect_waiting_room SET status = 'COMPLETED' WHERE call_id='" +
          params.call_id +
          "'";
          db.query(query, function (err, rowsupwaiting, fields) {
            if (err) {
              logger.error(
                "api callendbypatient -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            }else{

            }
          });
        
          res.status(200).json({ status_code: 200, status_message: "updated" });
        }
      });
    }
  });
};

exports.getdoctordetailbyid = function (req, res) {
  logger.info("api getdoctordetailbyid doctor_id " + req.params.id);
  if (!req.params.id || req.params.id == "" || req.params.id == 0) {
    logger.error(
      'api getdoctordetailbyid -Error_Message -validation failed "id is required"   :',
      __line
    );
    return res
      .status(400)
      .json({ status_code: 400, status_message: "invalid parameter value" });
  }
  var q =
    "select name,nick_name,email,phoneNo,state,city,degree from doctor where id = '" +
    req.params.id +
    "'";
  db.query(q, function (err, rows) {
    if (err) {
      logger.error(
        "api getdoctordetailbyid -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      return res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        res.status(200).json({
          status_code: 200,
          status_message: "all form fields",
          result: rows,
        });
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "no record found." });
      }
    }
  });
};

