var getRoomIdForProviderSetting = function (room, callback) {
  checkIfRoomExistsInGroup(room, function (err, result) {
    if (err) {
      callback(null, {
        status_code: 500,
        status_message: "internal server error",
      });
    }
    if (result.status_code == 200) {
      var query =
        "select connect_provider_id from connect_provider_groups where group_id =" +
        result.result.id;
      db.query(query, function (err, rows) {
        if (err) {
          logger.error(
            "api getRoomIdForProviderSetting -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          callback(null, {
            status_code: 500,
            status_message: "internal server error",
          });
        }
        if (rows.length > 0) {
          callback(null, {
            status_code: 200,
            status_message: "provider id",
            result: rows[0].connect_provider_id,
          });
        } else {
          callback(null, {
            status_code: 404,
            status_message: "provider id not found",
          });
        }
      });
    } else {
      callback(null, { status_code: 404, status_message: "data not found" });
    }
  });
};

var checkIfRoomExistsInGroup = function (room, callback) {
  logger.info("api checkIfRoomExistsInGroup room=", room);
  var query =
    "select connect_groups.id,connect_groups.employer_id,company_name from connect_groups LEFT JOIN worksman_company_list on worksman_company_list.employer_id=connect_groups.employer_id where room =  '" +
    room +
    "' AND is_active=1";
  // var query =
  //   "select connect_groups.id,connect_groups.employer_id from connect_groups where room =  '" +
  //   room +
  //   "' AND is_active=1";
  db.query(query, function (err, rows) {
    if (err) {
      logger.error(
        "api checkIfRoomExistsInGroup -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      callback(null, {
        status_code: 500,
        status_message: "internal server error",
      });
    }
    if (rows.length > 0) {
      callback(null, {
        status_code: 200,
        status_message: "room exists in group",
        result: rows[0],
      });
    } else {
      callback(null, {
        status_code: 404,
        status_message: "room doesnot exists in group",
      });
    }
  });
};

