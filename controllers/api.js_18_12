/* verify otp patient api */
exports.verifyOTP = function (req, res) {
  logger.info("api verifyOTP email/phone", req.params.verifyValue);
  if (req.params.otp == "" || req.params.verifyValue == "") {
    logger.error(
      'api verifyOTP -Error_Message -validation failed "otp,verifyValue is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var curDate = moment.utc().format("YYYY-MM-DD H:mm:ss");
    var query =
      "SELECT otp,expiry_timestamp,created_at FROM verification_code WHERE email = '" +
      req.params.verifyValue +
      "' OR mobile_number = '" +
      req.params.verifyValue +
      "' ORDER BY id DESC LIMIT 1";
    var sql = db.query(query, function (err, rows, fields) {
      if (err) {
        logger.error(
          "api verifyOTP -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
        return false;
      } else {
        if (rows) {
          if (
            (req.params.otp == rows[0].otp || req.params.otp == "000000") &&
            curDate >=
              moment(rows[0].created_at).format("YYYY-MM-DD H:mm:ss") &&
            curDate <=
              moment(rows[0].expiry_timestamp).format("YYYY-MM-DD H:mm:ss")
          ) {
            res.status(200).json({
              status_code: 200,
              status_message: "otp successfully verified",
            });
          } else {
            res.status(404).json({
              status_code: 404,
              status_message:
                "Sorry but it looks like you entered an incorrect or expired verification code.",
            });
          }
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "otp not found" });
        }
      }
    });
  }
};

