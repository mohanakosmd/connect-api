};
var insertexceldataindbfors1medical = function (
  exceldatalocation,
  exceldatarefral,
  index,
  employer_id,
  res
) {
  if (index == exceldatalocation.length) {
    return res.status(200).json({
      status_code: 200,
      status_message: "You have uploaded data successfully",
    });
  } else {
    var params = {
      employer_id: employer_id,
      name: exceldatalocation[index]["mbr entity name"],
      street: exceldatalocation[index]["mbr physical address line1"],
      city: exceldatalocation[index]["mbr physical city"],
      state: exceldatalocation[index]["mbr physical state"],
      zip_code: exceldatalocation[index]["mbr physical zip"],
    };
    if (params.name != "") {
      var query =
        'SELECT * FROM wc_locations WHERE  TRIM(name) = "' +
        params.name.trim() +
        '" AND employer_id = "' +
        employer_id +
        '"';
      db.query(query, function (error, rows) {
        if (error) {
          insertexceldataindbfors1medical(
            exceldatalocation,
            exceldatarefral,
            index,
            employer_id,
            res
          );
        } else {
          if (rows.length > 0) {
            if (compareobject(rows[0], params)) {
              insertwcreferralfors1medical(
                exceldatalocation,
                exceldatarefral,
                index,
                rows[0].id,
                employer_id,
                res
              );
            } else {
              if (
                params.name != "" &&
                params.city != "" &&
                params.street != "" &&
                params.employer_id != "" &&
                params.state != "" &&
                params.zip_code
              ) {
                db.query(
                  "UPDATE wc_locations SET ? WHERE id =" + rows[0].id + "",
                  params,
                  function (err, rowsupdae, fields) {
                    if (error) {
                      insertexceldataindbfors1medical(
                        exceldatalocation,
                        exceldatarefral,
                        index,
                        employer_id,
                        res
                      );
                    } else {
                      if (rowsupdae) {
                        insertwcreferralfors1medical(
                          exceldatalocation,
                          exceldatarefral,
                          index,
                          rows[0].id,
                          employer_id,
                          res
                        );
                      }
                    }
                  }
                );
              } else {
                insertwcreferralfors1medical(
                  exceldatalocation,
                  exceldatarefral,
                  index,
                  rows[0].id,
                  employer_id,
                  res
                );
              }
            }
          } else {
            if (
              params.name != "" &&
              params.city != "" &&
              params.street != "" &&
              params.employer_id != "" &&
              params.state != "" &&
              params.zip_code
            ) {
              db.query(
                "INSERT INTO wc_locations SET ?",
                params,
                function (err, rows, fields) {
                  if (error) {
                    insertwcreferralfors1medical(
                      exceldatalocation,
                      exceldatarefral,
                      index,
                      rows[0].id,
                      employer_id,
                      res
                    );
                  } else {
                    if (rows) {
                      insertwcreferralfors1medical(
                        exceldatalocation,
                        exceldatarefral,
                        index,
                        rows.insertId,
                        employer_id,
                        res
                      );
                    }
                  }
                }
              );
            } else {
              insertexceldataindbfors1medical(
                exceldatalocation,
                exceldatarefral,
                index + 1,
                employer_id,
                res
              );
            }
          }
        }
      });
    } else {
      insertexceldataindbfors1medical(
        exceldatalocation,
        exceldatarefral,
        index + 1,
        employer_id,
        res
      );
    }
  }
};
var insertwcreferralfors1medical = function (
  exceldatalocation,
  exceldatarefral,
  index,
  locationid,
  employer_id,
  res
) {
  var allreferall =
    exceldatarefral[exceldatalocation[index]["mbr member number"]];
  if (allreferall && allreferall.length > 0) {
    insertmultiplewcreferralforlocations1(
      exceldatalocation,
      exceldatarefral,
      index,
      locationid,
      employer_id,
      res,
      allreferall,
      0
    );
  } else {
    insertexceldataindbfors1medical(
      exceldatalocation,
      exceldatarefral,
      index + 1,
      employer_id,
      res
    );
  }
};
function mysql_real_escape_string(str) {
  return str.replace(/[\0\x08\x09\x1a\n\r"'\\\%]/g, function (char) {
    switch (char) {
      case "\0":
        return "\\0";
      case "\x08":
        return "\\b";
      case "\x09":
        return "\\t";
      case "\x1a":
        return "\\z";
      case "\n":
        return "\\n";
      case "\r":
        return "\\r";
      case '"':
      case "'":
      case "\\":
      case "%":
        return "\\" + char;
    }
  });
}

var insertmultiplewcreferralforlocations1 = function (
  exceldatalocation,
  exceldatarefral,
  index,
  locationid,
  employer_id,
  res,
  allreferall,
  index1
) {
  if (index1 == allreferall.length) {
    insertexceldataindbfors1medical(
      exceldatalocation,
      exceldatarefral,
      index + 1,
      employer_id,
      res
    );
  } else {
    var params = {
      employer_id: employer_id,
      wc_location_id: locationid,
      speciality_type: "Occupational Health Clinic",
      practice_name: allreferall[index1]["facility_name"],
      provider_name: mysql_real_escape_string(allreferall[index1]["physician"]),
      practice_address: allreferall[index1]["address1"],
      city: allreferall[index1]["city"],
      state: allreferall[index1]["state"],
      zip: allreferall[index1]["zip"],
      location_type: allreferall[index1]["type"] || "OTHER",
      email: "",
      phone: allreferall[index1]["phone"],
      fax: allreferall[index1]["fax"],
      preferred_referral_method: "phone",
      hours_of_operation: "",
      notes: allreferall[index1]["notes"],
    };
    if (
      params.practice_name != "" &&
      params.practice_address != "" &&
      params.wc_location_id != ""
    ) {
      var query =
        'SELECT * FROM wc_referrals WHERE  TRIM(practice_name) = "' +
        params.practice_name.trim() +
        '" AND TRIM(practice_address)  ="' +
        params.practice_address.trim() +
        '" AND wc_location_id = "' +
        params.wc_location_id +
        '"AND TRIM(provider_name) = "' +
        params.provider_name.trim() +
        '"';
      db.query(query, function (error, rows) {
