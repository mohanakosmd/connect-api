                result.patient_id = rows.insertId;
                result.registration_from = params.registration_from;
                result.uuid = params.uuid;
                params.patient_id = result.patient_id;
                logger.info(
                  "start submitting to practicesuite create patient api",
                  __line
                );
                //start- register with practicesuite
                practiceSuitePatientRegister(params.uuid).then(
                  function (result) {
                    logger.info(
                      "Patient details successfully submitted to practicesuite create patient api",
                      __line
                    );
                  },
                  function (err) {
                    logger.info(
                      "Something went wrong while submitting patient details to practicesuite create patient api",
                      __line
                    );
                  }
                );
                //End- register with practicesuite
                generateHgPatientId(params, function (err, callbackresult) {
                  if (err) {
                    res.status(200).json({
                      status_code: 200,
                      status_message: "user added",
                      result: result,
                    });
                  } else if (callbackresult.status_code == 200) {
                    res.status(200).json({
                      status_code: 200,
                      status_message: "user added",
                      result: result,
                    });
                  }
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "user not found" });
              }
            }
          }
        );
      }
    }
  });
};
