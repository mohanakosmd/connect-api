/*end*/

function getgroupname(params, res) {
  checkIfRoomExistsInGroup(params.alias, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var sql = db.query(
        "SELECT connect_provider.id,connect_provider.name,connect_provider.employer_id,connect_provider.is_active,connect_provider_groups.group_id ,connect_groups.room as group_name FROM connect_provider_groups JOIN connect_groups ON connect_groups.id = connect_provider_groups.group_id JOIN connect_provider ON connect_provider.id = connect_provider_groups.connect_provider_id WHERE connect_provider_groups.group_id = '" +
          result.result.id +
          "'",
        function (err, rows, fields) {
          if (err) {
            logger.error(
              "api getgroupname -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "  :",
              __line
            );
            res.status(500).json({
              status_code: 500,
              status_message: "internal server error",
            });
          } else {
            if (rows.length > 0) {
              for (var i = 0; i < rows.length; i++) {
                if (rows[i].is_active == 1) {
                  rows[i].employer_id = result.result.employer_id;
                  rows[i].company_name = result.result.company_name;
                  var callbackresult = rows[0];
                  rows[0] = rows[i];
                  rows[i] = callbackresult;
                  break;
                }
              }
              res.status(200).json({
                status_code: 200,
                status_message: "doctor data",
                result: rows,
              });
            } else {
              res
                .status(404)
                .json({ status_code: 404, status_message: "doctor not found" });
            }
          }
        }
      );
    } else {
      res
        .status(404)
        .json({ status_code: 404, status_message: "data not found" });
    }
  });
}
