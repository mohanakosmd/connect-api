exports.patientexists = function (req, res) {
  logger.info("api patientexists first name =", req.body.first_name);
  if (req.body.first_name == "" || req.body.last_name == "") {
    logger.error(
      'api patientexists -Error_Message -validation failed "first_name,last_name is required"    :',
      __line
    );
    return res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
  }
  var employerId = req.body.employerId || "";
  var connectConfig;
  var regFrom = "";
  var selectQuery =
    "SELECT id,phone,first_name,last_name,email,dateofbirth,gender,address1,city,state,zip_code,registration_from,uuid,hg_patient_id,password FROM patient";
  var where = " WHERE ";
  //get config from employerId
  // getConnectClientConfig(employerId, function (response) {
  // enablePhoneCheck = response[0].check_patient_exists_by_phone
  // enableEmailCheck = response[0].check_patient_exists_by_email
  // if (enablePhoneCheck && req.body.phone == '') {
  // 	logger.error('api patientexists -Error_Message -validation failed "phone is required"    :',__line);
  // 	return res.status(201).json({ 'status_code': 201, "status_message": "invalid parameter or value passed" });
  // }
  if (
    (!req.body.email && !req.body.phone) ||
    (req.body.email == "" && req.body.phone == "")
  ) {
    logger.error(
      'api patientexists -Error_Message -validation failed "email is required"    :',
      __line
    );
    return res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
  }
  if (!req.body.email || req.body.email == "") {
    where +=
      " phone= '" +
      req.body.phone +
      "' AND first_name='" +
      req.body.first_name +
      "'AND last_name= '" +
      req.body.last_name +
      "'";
  } else {
    where +=
      " email= '" +
      req.body.email +
      "'AND first_name='" +
      req.body.first_name +
      "'AND last_name= '" +
      req.body.last_name +
      "'";
  }
  //get client name
  //getConnectClientName(employerId, req.body.registration_from, function (response) {
  //regFrom = response.client_name
  var query = selectQuery + where + " ORDER BY id DESC LIMIT 1";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api patientexists -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "   :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows.length > 0) {
        getJwtAuthToken(
          rows[0].uuid,
          "patient-app",
          function (err, callbackresult) {
            if (err) {
              res
                .status(401)
                .json({ status_code: 401, status_message: errorAuthToken });
            } else if (callbackresult.status_code == 200) {
              rows[0].access_token = callbackresult.data.access_token;
              res.status(200).json({
                status_code: 200,
                status_message: "user exists",
                result: rows,
              });
            }
          }
        );
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "user not found" });
      }
    }
  });
  //});
  // });
  return false;
};

exports.getWaitingUserListFromUserId = function (req, res) {
  logger.info(
    "api getWaitingUserListFromUserId pcp_doctor_id=",
    req.body.body.pcp_doctor_id
  );
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.token == "") {
    logger.error(
      'api getWaitingUserListFromUserId -Error_Message -validation failed "Authorization_Token is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed1",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = {
        patient_id: req.body.body.patient_id,
        pcp_doctor_id: req.body.body.pcp_doctor_id,
        group_id: req.body.body.group_id,
      };
      if (params.patient_id == "" || params.pcp_doctor_id == "") {
        logger.error(
          'api getWaitingUserListFromUserId -Error_Message -validation failed "patient_id,pcp_doctor_id is required"    :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "invalid parameter or value passed2",
        });
        return false;
      } else {
        var q =
          "select * from patient join connect_waiting_room on patient.id = connect_waiting_room.patient_id where ((connect_waiting_room.patient_id =" +
          params.patient_id +
          ') AND (connect_waiting_room.status = "waiting" OR  connect_waiting_room.status = "In progress" OR  connect_waiting_room.status = "PENDING" OR  connect_waiting_room.status = "IN CONSULTATION"))';
        db.query(q, function (err, rows) {
          if (err) {
            logger.error(
              "api getWaitingUserListFromUserId -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "   :",
              __line
            );
            res.status(500).json({
              status_code: 500,
              status_message: "internal server error",
            });
          } else {
            if (rows.length > 0) {
              if (rows[0].group_id == 0) {
                var q =
                  "select patient.*,connect_waiting_room.*,connect_call_log.call_location,patient_record.call_type,patient_record.doctor_instruction,connect_thirdparty_url.invite_id  from connect_waiting_room JOIN  connect_call_log ON connect_call_log.call_id = connect_waiting_room.call_id join patient on patient.id = connect_waiting_room.patient_id JOIN patient_record ON patient_record.id = connect_waiting_room.call_id JOIN connect_thirdparty_url ON connect_thirdparty_url.call_id = connect_waiting_room.call_id where ((connect_waiting_room.pcp_doctor_id =" +
                  params.pcp_doctor_id +
                  " AND  connect_waiting_room.patient_id =" +
                  params.patient_id +
                  ')AND (connect_waiting_room.status = "waiting" OR  connect_waiting_room.status = "In progress"  OR  connect_waiting_room.status = "PENDING" OR  connect_waiting_room.status = "IN CONSULTATION") AND connect_waiting_room.checked_in > date_sub(now(), interval ' +
                  config.waiting_list_duration +
                  " HOUR))";
                db.query(q, function (err, rows) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "user data",
                    result: rows,
                  });
                });
              } else {
                params.groupid = "";
                for (var i = 0; i < params.group_id.length; i++) {
                  params.groupid = params.groupid + params.group_id[i].id;
                  if (i != params.group_id.length - 1) {
                    params.groupid = params.groupid + ",";
                  }
                }
                var q =
                  "select patient.*,connect_waiting_room.*,connect_call_log.call_location,patient_record.call_type,patient_record.doctor_instruction,connect_thirdparty_url.invite_id from connect_waiting_room JOIN  connect_call_log ON connect_call_log.call_id = connect_waiting_room.call_id join patient on patient.id = connect_waiting_room.patient_id JOIN patient_record ON patient_record.id = connect_waiting_room.call_id JOIN connect_thirdparty_url ON connect_thirdparty_url.call_id = connect_waiting_room.call_id where ((connect_waiting_room.group_id IN (" +
                  params.groupid +
                  ") AND  connect_waiting_room.patient_id =" +
                  params.patient_id +
                  ')AND (connect_waiting_room.status = "waiting" OR  connect_waiting_room.status = "In progress"  OR  connect_waiting_room.status = "PENDING" OR  connect_waiting_room.status = "IN CONSULTATION") AND connect_waiting_room.checked_in > date_sub(now(), interval ' +
                  config.waiting_list_duration +
                  " HOUR))";
                db.query(q, function (err, rows1) {
                  res.status(200).json({
                    status_code: 200,
                    status_message: "user data",
                    result: rows1,
                  });
                });
              }
            } else {
              res
                .status(404)
                .json({ status_code: 404, status_message: "user not found" });
            }
          }
        });
      }
    }
  });
};

