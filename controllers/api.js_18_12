exports.getDocCallLogData = function (req, res) {
  logger.info(
    "api getDocCallLogData connect_provider_id",
    req.params.doctor_id
  );
  var headers = {
    token: req.headers.authorization_token,
    uuid: req.headers.uuid,
  };
  console.log("headers: ", headers);
  if (
    headers.token == "" ||
    headers.token == undefined ||
    headers.token == null
  ) {
    logger.error(
      'api getDocCallLogData -Error_Message -validation failed "authorization_token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var query =
        "SELECT connect_provider.doctor_id as assign_doctor_id, patient.uniquePatientId, patient.first_name,patient.phone,patient.last_name,patient.dateofbirth,patient.gender,patient.state,patient.city,patient.zip_code,patient.address1,patient.address2,patient.email,patient.uuid,connect_call_log.*,connect_call_log.doctor_instruction, connect_call_log.id as ccl_id FROM connect_call_log JOIN patient ON patient.id = connect_call_log.patient_id JOIN connect_provider ON connect_provider.uuid ='" +
        headers.uuid +
        "' AND  connect_provider.id ='" +
        req.params.doctor_id +
        "'WHERE connect_call_log.doctor_id = " +
        req.params.doctor_id;
      db.query(query, function (err, rows, fields) {
        if (err) {
          logger.error(
            "api getDocCallLogData -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          if (rows.length > 0) {
            res.status(200).json({
              status_code: 200,
              status_message: "doctor call log data",
              result: rows,
            });
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "doctor not found" });
          }
        }
      });
    }
  });
};
/* get doctor call log doc api end */

