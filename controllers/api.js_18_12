/* stopDoctorArchive api start */
exports.stopDoctorArchive = function (req, res) {
  logger.info("api stopDoctorArchive patientId =", req.body.patientId);
  var params = { patientId: req.body.patientId, archiveId: req.body.archiveId };
  if (!params.patientId || !params.archiveId) {
    logger.error(
      'api stopDoctorArchive -Error_Message -validation failed "patientId,archiveId is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "inavlid parameter or value passed",
    });
    return false;
  }
  var q =
    "select * from connect_waiting_room where patient_id = " +
    params.patientId +
    " and archive_id = '" +
    params.archiveId +
    "'";
  db.query(q, function (err, rows) {
    if (rows && rows.length > 0) {
      opentok.stopArchive(params.archiveId, function (err, archive) {
        if (err) {
          logger.error(
            "api stopDoctorArchive -Error_Code :-",
            err,
            "   :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          res.status(200).json({
            status_code: 200,
            status_message: "recording stopped",
            result: archive.id,
          });
        }
      });
    } else {
      res.status(404).json({
        status_code: 404,
        status_message: "either patient id or archive id is not valid",
      });
    }
  });
};
/* stopDoctorArchive api end */

