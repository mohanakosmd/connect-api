/* doctor login api start */
exports.preDoctorLogin = function (req, res) {
  logger.info("api  preDoctorLogin email =", req.body.email);
  var errorMessage =
    "Sorry but we couldn't log you in. Please verify the details you entered and try again";
  var errorInternal = "Something went wrong";
  var params = {
    email: req.body.email,
    password: req.body.password,
    employerId: req.body.employerId,
  };
  if (params.email == "" || params.password == "") {
    logger.error(
      'api preDoctorLogin -Error_Message -validation failed "email,password is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "inavlid parameter or value passed",
    });
    return false;
  }
  var pass = params.password;
  if (pass.length < 25) {
    password = crypto.createHash("md5").update(params.password).digest("hex");
  } else {
    password = pass;
  }
  var query =
    'SELECT * FROM connect_provider WHERE email = "' +
    params.email +
    "\" AND password = '" +
    password +
    "'";
  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api preDoctorLogin -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "   :",
        __line
      );
      res.status(500).json({ status_code: 500, status_message: errorInternal });
    } else {
      if (rows.length == 1) {
        if (rows[0].active != 1) {
          logger.error(
            "api doctorLogin - ,Error_Message :-, account disabled   :",
            __line
          );
          res.status(404).json({
            status_code: 404,
            status_message: config.account_disabled_msg,
          });
          return false;
        }
        let doctor = {
          email: rows[0].email,
          phoneNo: rows[0].phoneNo,
          name: rows[0].name,
          uuid: rows[0].uuid,
        };
        res.status(200).json({
          status_code: 200,
          status_message: "successfully logged in",
          result: doctor,
        });
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: errorMessage });
      }
    }
  });
};

exports.doctorLogin = function (req, res) {
  logger.info("api  doctorLogin email =", req.body.email);
  var errorMessage =
    "Sorry but we couldn't log you in. Please verify the details you entered and try again";
  var errorInternal = "Something went wrong";
  var params = {
    email: req.body.email,
    password: req.body.password,
    employerId: req.body.employerId,
  };
  if (params.email == "" || params.password == "") {
    logger.error(
      'api doctorLogin -Error_Message -validation failed "email,password is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "inavlid parameter or value passed",
    });
    return false;
  }
  var pass = params.password;
  if (pass.length < 25) {
    password = crypto.createHash("md5").update(params.password).digest("hex");
  } else {
    password = pass;
  }

  var query =
    'SELECT p.*, d.npiNumber, d.degree FROM connect_provider as p inner join doctor as d on p.doctor_id = d.id WHERE p.email = "' +
    params.email +
    "\" AND p.password = '" +
    password +
    "'";
  // var query = `
  // SELECT p.*, d.npiNumber, d.degree
  // FROM connect_provider as p
  // INNER JOIN doctor as d ON p.doctor_id = d.id
  // WHERE p.email = "${params.email}" AND p.password = "${password}"`;

  var sql = db.query(query, function (err, rows, fields) {
    if (err) {
      logger.error(
        "api doctorLogin -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "   :",
        __line
      );
      res.status(500).json({ status_code: 500, status_message: errorInternal });
    } else {
      if (rows.length == 1) {
        if (rows[0].active != 1) {
          logger.error(
            "api doctorLogin - ,Error_Message :-, account disabled   :",
            __line
          );
          res.status(404).json({
            status_code: 404,
            status_message: config.account_disabled_msg,
          });
          return false;
        }

        var query =
          "SELECT connect_groups.description,connect_groups.employer_id,connect_groups.type,connect_groups.rotateCamera,connect_groups.screenShare,connect_groups.screenShot,connect_groups.callRecording,connect_groups.toggle_camera,connect_groups.mute_unmute,connect_groups.video_conference,connect_groups.start_stop_recording,connect_groups.toggle_full_screen,connect_groups.dial_call,group_id ,room as room_alias FROM connect_provider_groups JOIN connect_groups on connect_provider_groups.group_id=connect_groups.id WHERE connect_provider_id = '" +
          rows[0].id +
          "'";
        var sql = db.query(query, function (err, groupsrows, fields) {
          if (err) {
            logger.error(
              "api doctorLogin -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "   :",
              __line
            );
            res
              .status(500)
              .json({ status_code: 500, status_message: errorInternal });
          } else {
            var group_array = [];
            if (groupsrows.length > 0) {
              for (var i = 0; i < groupsrows.length; i++) {
                var obj = {};
                obj.id = groupsrows[i].group_id;
                obj.room_alias = groupsrows[i].room_alias;
                obj.type = groupsrows[i].type;
                obj.description = groupsrows[i].description;
                obj.toggle_camera = groupsrows[i].toggle_camera;
                obj.mute_unmute = groupsrows[i].mute_unmute;
                obj.video_conference = groupsrows[i].video_conference;
                obj.start_stop_recording = groupsrows[i].start_stop_recording;
                obj.toggle_full_screen = groupsrows[i].toggle_full_screen;
                obj.dial_call = groupsrows[i].dial_call;
                obj.callRecording = groupsrows[i].callRecording;
                obj.screenShare = groupsrows[i].screenShare;
                obj.screenShot = groupsrows[i].screenShot;
                obj.rotateCamera = groupsrows[i].rotateCamera;
                obj.employer_id = groupsrows[i].employer_id;
                group_array.push(obj);
              }
            } else {
              var obj = {};
              obj.id = 0;
              obj.room_alias = rows[0].room_alias;
              obj.type = "PCP";
              obj.description = rows[0].name;
              obj.toggle_camera = null;
              obj.mute_unmute = null;
              obj.video_conference = null;
              obj.start_stop_screen = null;
              obj.toggle_full_screen = null;
              obj.dial_call = null;
              obj.callRecording = null;
              obj.screenShare = null;
              obj.screenShot = null;
              obj.rotateCamera = null;
              obj.employer_id = null;
              group_array.push(obj);
            }

            var doctor;
            doctor = {
              id: rows[0].id,
              name: rows[0].name,
              email: rows[0].email,
              uuid: rows[0].uuid,
              phoneNo: rows[0].phoneNo,
              room_alias: group_array,
              group_id: group_array,
              employer_id: rows[0].employer_id,
              token: randomValueBase64(72),
              npiNumber: rows[0].npiNumber,
              degree: rows[0].degree,
            };
            if (rows[0].room == "") {
              doctor.room = randomRoomNumber();
              var updateToken = db.query(
                "UPDATE connect_provider SET  is_active = 1, token = '" +
                  doctor.token +
                  "' , room = " +
                  doctor.room +
                  " WHERE id = " +
                  doctor.id +
                  "",
                function (err, rows, fields) {
                  console.log(rows, err);

                  if (rows) {
                    getJwtAuthToken(
                      doctor.uuid,
                      "connect",
                      function (err, callbackresult) {
                        if (err) {
                          res.status(401).json({
                            status_code: 401,
                            status_message: errorAuthToken,
                          });
                        } else if (callbackresult.status_code == 200) {
                          doctor.access_token =
                            callbackresult.data.access_token;
                          res.status(200).json({
                            status_code: 200,
                            status_message: "successfully logged in",
                            result: doctor,
                          });
                        }
                      }
                    );
                  } else {
                    logger.error(
                      "api doctorLogin -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "   :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: errorInternal,
                    });
                  }
                }
              );
            } else {
              doctor.room = rows[0].room;
              var updateToken = db.query(
                "UPDATE connect_provider SET is_active = 1, token = '" +
                  doctor.token +
                  "' WHERE id = " +
                  doctor.id +
                  "",
                function (err, rows, fields) {
                  if (rows) {
                    getJwtAuthToken(
                      doctor.uuid,
                      "connect",
                      function (err, callbackresult) {
                        if (err) {
                          res.status(401).json({
                            status_code: 401,
                            status_message: errorAuthToken,
                          });
                        } else if (callbackresult.status_code == 200) {
                          doctor.access_token =
                            callbackresult.data.access_token;
                          res.status(200).json({
                            status_code: 200,
                            status_message: "successfully logged in",
                            result: doctor,
                          });
                        }
                      }
                    );
                  } else {
                    logger.error(
                      "api doctorLogin -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "   :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: errorInternal,
                    });
                  }
                }
              );
            }
          }
        });
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: errorMessage });
      }
    }
  });
};
/* doctor login api end */

/* doctor update room alias api*/
exports.updateDocRoomAlias = function (req, res) {
  logger.info("api updateDocRoomAlias connect_provider Id=", req.body.body.id);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api updateDocRoomAlias -Error_Message -validation failed "Authorization_Token is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = {
        id: req.body.body.id,
        room_alias: req.body.body.room_alias,
      };
      if (params.id == "" || params.room_alias == "") {
        logger.error(
          'api updateDocRoomAlias -Error_Message -validation failed "id,room_alias is required"    :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "inavlid parameter or value passed",
        });
        return false;
      }
      var sql = db.query(
        "UPDATE connect_provider SET room_alias = '" +
          params.room_alias +
          "' WHERE id=" +
          params.id,
        function (err, rows, fields) {
          if (err) {
            logger.error(
              "api updateDocRoomAlias -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "   :",
              __line
            );
            res.status(500).json({
              status_code: 500,
              status_message: "internal server error",
            });
          } else if (rows) {
            res
              .status(200)
              .json({ status_code: 200, status_message: "alias updated" });
          }
        }
      );
    }
  });
};
/* doctor update room alias end*/

/* doctor logout api */
exports.doctorLogout = function (req, res) {
  logger.info("api doctorLogout connect_provider id=", req.body.body.id);
  var params = {
    id: req.body.body.id,
    xauthtoken: req.headers["x-auth-token"],
  };
  if (params.id == "") {
    logger.error(
      'api doctorLogout -Error_Message -validation failed "id is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var sql = db.query(
      "SELECT * FROM connect_provider WHERE id=" + params.id,
      function (err, rows, fields) {
        if (err) {
          logger.error(
            "api doctorLogout -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "   :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          if (rows.length == 1) {
            db.query(
              'UPDATE connect_provider SET token = "" , is_active = 0 WHERE id=' +
                params.id,
              function (err, rows, fields) {
                if (err) {
                  logger.error(
                    "api doctorLogout -Error_Code :-",
                    err.code,
                    "Error_Message :-",
                    err.sqlMessage,
                    "   :",
                    __line
                  );
                  res.status(500).json({
                    status_code: 500,
                    status_message: "internal server error",
                  });
                } else {
                  if (params.xauthtoken) {
                    Request.post(
                      {
                        headers: {
                          "Content-Type": "application/x-www-form-urlencoded",
                          "X-AUTH-TOKEN": params.xauthtoken,
                        },
                        url: config.newapi.baseurl + "/v1/tokens/invalidate",
                        body: JSON.stringify({
                          access_token: params.xauthtoken,
                        }),
                      },
                      (error, response, body) => {
                        if (error) {
                          logger.error(
                            "api doctorLogout -Error_Code :-",
                            error,
                            "   :",
                            __line
                          );
                          res.status(200).json({
                            status_code: 200,
                            status_message: "successfully logged out",
                          });
                        }
                        res.status(200).json({
                          status_code: 200,
                          status_message: "successfully logged out",
                        });
                      }
                    );
                  } else {
                    res.status(200).json({
                      status_code: 200,
                      status_message: "successfully logged out",
                    });
                  }
                }
              }
            );
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "doctor not found" });
          }
        }
      }
    );
  }
};
/* add for change status by patientid (08302018)*/
exports.checkstatusinwatingroom = function (req, res) {
  logger.info("api checkstatusinwatingroom patient_id=", req.body.patient_id);
  if (req.body.patient_id == "" || req.body.patient_id == undefined) {
    logger.error(
      'api checkstatusinwatingroom -Error_Message -validation failed "patient_id is required"    :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }

  var query =
    "SELECT status,call_id FROM  connect_waiting_room WHERE patient_id = '" +
    req.body.patient_id +
    "' ORDER BY id DESC LIMIT 1";
  var sql = db.query(query, function (err, status, fields) {
    if (err) {
      logger.error(
        "api checkstatusinwatingroom -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "   :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (status.length > 0) {
        if (status[0].status == "In progress") {
          res.status(402).json({
            status_code: 402,
            status_message:
              "We were not able to connect.Because you are already in conference",
          });
        } else {
          var query =
            'UPDATE connect_waiting_room SET status = "waiting" WHERE patient_id=' +
            req.body.patient_id;
          db.query(query, function (err, update, fields) {
            if (err) {
              logger.error(
                "api checkstatusinwatingroom -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "   :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
//              socket.emit("onStatusChange", {
  //              call_id: status[0].call_id,
    //            mesage: "Status Changed",
      //        });
              res
                .status(200)
                .json({ status_code: 200, status_message: "user exists" });
            }
          });
        }
      } else {
        res
          .status(200)
          .json({ status_code: 200, status_message: "user exists" });
      }
    }
  });
};
