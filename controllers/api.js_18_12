      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var sql = db.query(
      "SELECT id FROM patient WHERE email = '" +
        params.email +
        "' OR phone = '" +
        params.email +
        "' ORDER BY id DESC LIMIT 1",
      params,
      function (err, rows, fields) {
