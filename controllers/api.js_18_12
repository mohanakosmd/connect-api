exports.getProviderSetting = function (req, res) {
  logger.info("api getProviderSetting room", req.params.room);
  var query =
    "select id from connect_provider  WHERE room = '" +
    req.params.room +
    "' OR room_alias ='" +
    req.params.room +
    "'";
  db.query(query, function (err, rows) {
    if (err) {
      logger.error(
        "api getProviderSetting -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (rows.length > 0) {
      var sql = db.query(
        "SELECT * FROM connect_provider_groups WHERE connect_provider_id = '" +
          rows[0].id +
          "'",
        function (err, rows1, fields) {
          if (err) {
            logger.error(
              "api getProviderSetting -Error_Code :-",
              err.code,
              "Error_Message :-",
              err.sqlMessage,
              "  :",
              __line
            );
            res.status(500).json({
              status_code: 500,
              status_message: "internal server error",
            });
          }
          if (rows1.length > 0) {
            var q =
              "select room,type from connect_groups where id = " +
              rows1[0].group_id;
            db.query(q, function (err, rows) {
              if (err) {
                logger.error(
                  "api getProviderSetting -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                var grouptype = rows[0].type;
                getRoomIdForProviderSetting(
                  rows[0].room,
                  function (err, result) {
                    //got the doc id
                    if (err) {
                      res.status(500).json({
                        status_code: 500,
                        status_message: "internal server error",
                      });
                    }
                    if (result.status_code == 200) {
                      var query =
                        "SELECT * FROM connect_provider_settings WHERE provider_id =" +
                        result.result;
                      db.query(query, function (err, rows) {
                        if (err) {
                          logger.error(
                            "api getProviderSetting -Error_Code :-",
                            err.code,
                            "Error_Message :-",
                            err.sqlMessage,
                            "  :",
                            __line
                          );
                          res.status(500).json({
                            status_code: 500,
                            status_message: "internal server error",
                          });
                        } else {
                          if (rows) {
                            rows[0].type = grouptype;
                            res.status(200).json({
                              status_code: 200,
                              status_message: "connect provider settings",
                              result: rows,
                            });
                          } else {
                            res.status(404).json({
                              status_code: 404,
                              status_message: "data not found",
                            });
                          }
                        }
                      });
                    }
                  }
                );
              }
            });
          } else {
            var query =
              "SELECT * FROM connect_provider_settings WHERE provider_id =" +
              rows[0].id;
            db.query(query, function (err, rows) {
              if (err) {
                logger.error(
                  "api getProviderSetting -Error_Code :-",
                  err.code,
                  "Error_Message :-",
                  err.sqlMessage,
                  "  :",
                  __line
                );
                res.status(500).json({
                  status_code: 500,
                  status_message: "internal server error",
                });
              } else {
                if (rows) {
                  rows[0].type = "PCP";
                  res.status(200).json({
                    status_code: 200,
                    status_message: "connect provider settings",
                    result: rows,
                  });
                } else {
                  res.status(404).json({
                    status_code: 404,
                    status_message: "data not found",
                  });
                }
              }
            });
          }
        }
      );
    } else {
      getRoomIdForProviderSetting(req.params.room, function (err, result) {
        //got the doc id
        if (err) {
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        }
        if (result.status_code == 200) {
          var query =
            "SELECT * FROM connect_provider_settings WHERE provider_id =" +
            result.result;
          db.query(query, function (err, rows) {
            if (err) {
              logger.error(
                "api getProviderSetting -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                var query =
                  "SELECT type FROM connect_groups WHERE room ='" +
                  req.params.room +
                  "'";
                db.query(query, function (err, groupname) {
                  if (err) {
                    logger.error(
                      "api getProviderSetting -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "  :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: "internal server error",
                    });
                  } else {
                    if (groupname.length > 0) {
                      rows[0].type = groupname[0].type;
                      res.status(200).json({
                        status_code: 200,
                        status_message: "connect provider settings",
                        result: rows,
                      });
                    } else {
                      rows[0].type = "PCP";
                      res.status(200).json({
                        status_code: 200,
                        status_message: "connect provider settings",
                        result: rows,
                      });
                    }
                  }
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "data not found" });
              }
            }
          });
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "data not found" });
        }
      });
    }
  });
};

exports.getProviderSettingByProviderId = function (req, res) {
  logger.info("api getProviderSettingByProviderId provider id", req.params.id);
  if (
    req.params.id == undefined ||
    req.params.id == "undefined" ||
    req.params.id.trim() == ""
  ) {
    logger.error(
      'api getProviderSettingByProviderId -Error_Message -validation failed "id is required"   :',
      __line
    );
    res.status(400).json({
      status_code: 400,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  var query =
    "SELECT * FROM connect_provider_settings WHERE provider_id =" +
    req.params.id;
  db.query(query, function (err, rows) {
    if (err) {
      logger.error(
        "api getProviderSettingByProviderId -Error_Code :-",
        err.code,
        "Error_Message :-",
        err.sqlMessage,
        "  :",
        __line
      );
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (rows) {
        res.status(200).json({
          status_code: 200,
