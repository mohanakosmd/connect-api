exports.lockCallEncounter = function (req, res) {
  logger.info(
    "api  lockCallEncounter connect_call_log id/call_id",
    req.body.body.call_id
  );
  var headers = { token: req.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api lockCallEncounter -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = {};
      params.id = req.body.body.call_id;
      params.doctor_instruction = req.body.body.doctor_instruction;
      var da = JSON.parse(params.doctor_instruction);
      if (da.doctor_instruction.operation == "lock") {
        var isLocked = 1;
      } else if (da.doctor_instruction.operation == "save") {
        var isLocked = 0;
      } else {
        var isLocked = 0;
      }
      if (req.body.body.savebycallid) {
        var query =
          "UPDATE connect_call_log SET is_call_locked = " +
          isLocked +
          ", doctor_instruction = '" +
          params.doctor_instruction +
          "' WHERE call_id=" +
          req.params.call_id;
      } else {
        var query =
          "UPDATE connect_call_log SET is_call_locked = " +
          isLocked +
          ", doctor_instruction = '" +
          params.doctor_instruction +
          "' WHERE id=" +
          req.params.call_id;
      }
      db.query(query, function (err, rows, fields) {
        if (err) {
          logger.error(
            "api lockCallEncounter -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
        } else {
          if (rows) {
            res.status(200).json({
              status_code: 200,
              status_message: "successfully updated data",
              result: rows,
            });
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "id not found" });
          }
        }
      });
    }
  });
};
/* get doctor call log doc api end */

/* insert patient call record after call end -- doc api start  */
exports.makeCallRecord = function (req, res) {
  logger.info("api makeCallRecord patientId", req.body.body.patientId);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api makeCallRecord -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = {
        patientId: req.body.body.patientId,
        archive_id: req.body.body.archive_id,
        call_started: req.body.body.call_started,
        call_ended: req.body.body.call_ended,
        reason: req.body.body.reason,
        status: req.body.body.status,
        test_call: req.body.body.test_call,
      };
     
      if (
        params.patientId == "" ||
        params.call_started == "" ||
        params.call_ended == ""
      ) {
        logger.error(
          'api makeCallRecord -Error_Message -validation failed "patientId,call_started,call_ended is required"   :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "invalid parameter or value passed",
        });
        return false;
      } else {
        var sql = db.query(
          "SELECT connect_waiting_room.*, patient.uuid FROM connect_waiting_room join patient on patient.id = connect_waiting_room.patient_id WHERE patient_id =" +
            params.patientId +
            "",
          params,
          function (err, rows, fields) {
            if (err) {
              logger.error(
                "api makeCallRecord -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                var data = {};
                data.archive_id = rows[0].archive_id;
                data.symptoms = rows[0].pcp_symptom;
                data.allergies = rows[0].pcp_allergy;
                data.medications = rows[0].pcp_medication;
                data.medical_conditions = rows[0].pcp_medical_condition;
                var checked_in = new Date();
                data.call_ended = moment(checked_in).format(
                  "YYYY-MM-DD HH:mm:ss"
                );
                if (params.status.toLowerCase() != "pending") {
                  data.is_completed = 1;
                }
                data.token = rows[0].token;
                data.sessionid = rows[0].session;
                data.checked_in = rows[0].checked_in;
                data.test_call = params.test_call;
                data.nurse_disconnected_at = data.call_ended;
                data.is_work_related = req.body.body.is_work_related;
                data.outside_care_referral =
                  req.body.body.outside_care_referral;
                var call_id = rows[0].call_id;
                var call_status = rows[0].status;
                //Update appointment completed here
                if (params.status.toLowerCase() == "completed") {
                  // Fetch the appointmentId after updating
                  logger.info('api makeCallRecord callId', rows[0].call_id);
                  logger.info('api makeCallRecord patientId', req.body.body.patientId);

                  db.query(
                    "SELECT appointmentId FROM connect_call_log WHERE call_id = ? AND patient_id = ?",
                    [rows[0].call_id, req.body.body.patientId],
                    function (err, row) {
                      if (err) {
                        res.status(500).json({
                          status_code: 500,
                          status_message: "Internal server error",
                        });
                      } else {
                        logger.info('api makeCallRecord row', row);
                        if (row.length > 0) {
                          logger.info('api makeCallRecord row[0].appointmentId', row[0].appointmentId);
                          if(row[0].appointmentId){
                            const appointmentId = row[0].appointmentId;
                            //Now update appointmentId
                            if (appointmentId) {
                              var data_appointment = {};
                              data_appointment.status = 2;
                              data_appointment.callId = rows[0].call_id;                          
                              db.query(
                              "UPDATE appointments SET ? WHERE id =" + appointmentId +
                                "",
                                data_appointment,
                              function (err, rows, fields) {
                                  if (err) {
                                      res.status(500).json({
                                          status_code: 500,
                                          status_message: "Internal server error",
                                      });
                                  } else {
                                      if (rows) {
                                        console.log('Appointment updated successfully');
                                        res.status(200).json({
                                          status_code: 200,
                                          status_message: "pcp patient record updated",
                                          result: rows,
                                        });
                                      }
                                  }
                              });
                            }
                          }
                        }
                      }
                    }
                  );
                }
                var insertData = db.query(
                  "UPDATE connect_call_log SET ? WHERE call_id =" +
                    rows[0].call_id +
                    "",
                  data,
                  function (err, rows, fields) {
                    if (err) {
                      logger.error(
                        "api makeCallRecord -Error_Code :-",
                        err.code,
                        "Error_Message :-",
                        err.sqlMessage,
                        "  :",
                        __line
                      );
                      res.status(500).json({
                        status_code: 500,
                        status_message: "internal server error",
                      });
                    } else {
                      if (rows) {
                        if (call_status.toLowerCase() == "in consultation") {
                          req.body.status = "IN CONSULTATION"; //'COMPLETED';
                        } else {
                          req.body.status = params.status; //'COMPLETED';
                        }
                        req.body.call_id = call_id;
                        updateWaitingRoomUser(req, function (err, result) {
                          if (err) {
                            res.status(500).json({
                              status_code: 500,
                              status_message: "internal server error",
                            });
                          }
                          if (result.status_code == 200) {
                            var response = {};
                            response.callId = rows.insertId;
                            res.status(200).json({
                              status_code: 200,
                              status_message: "pcp patient record created",
                              result: response,
                            });
                          } else {
                            res.status(404).json({
                              status_code: 404,
                              status_message: "patient not found",
                            });
                          }
                        });
                      } else {
                        res.status(404).json({
                          status_code: 404,
                          status_message: "patient not found",
                        });
                      }
                    }
                  }
                );
              }
            }
          }
        );
      }
    }
  });
};
