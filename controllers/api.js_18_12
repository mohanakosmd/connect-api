    logger.error(
      'api updatestatusBycallId -Error_Message -validation failed "call_id is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  updateWaitingRoomUser(req, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    } else {
      if (result.status_code == 200) {
        if (req.body.disconnectByDoctor) {
          var checked_in = new Date();
          var doctor_call_end_at = moment(checked_in).format(
            "YYYY-MM-DD HH:mm:ss"
          );
          var query =
            "UPDATE patient_record SET doctor_call_end_at = '" +
            doctor_call_end_at +
            "' WHERE id= '" +
            req.body.call_id +
            "'";
          db.query(query, function (err, patientupdate, fields) {
            if (err) {
              logger.error(
                "api updatestatusBycallId -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(200).json({
                status_code: 200,
                status_message: "successfully updated status",
                result: result.result,
              });
            } else {
              res.status(200).json({
                status_code: 200,
                status_message: "successfully updated status",
                result: result.result,
              });
            }
          });
        } else {
          res.status(200).json({
            status_code: 200,
            status_message: "successfully updated status",
            result: result.result,
          });
        }
      } else {
        res
          .status(404)
          .json({ status_code: 404, status_message: "id not found" });
      }
    }
  });
};

exports.sendOTP = function (req, res) {
  logger.info("api sendOTP email/phone=", req.body.verifyValue);
  var params = {
    verifyType: req.body.verifyType,
    verifyValue: req.body.verifyValue,
    alias: req.body.alias,
  };
  if (
    params.verifyType == "" ||
    params.verifyType == undefined ||
    params.verifyValue == "" ||
    params.verifyValue == undefined ||
    params.alias == "" ||
    params.alias == undefined
  ) {
    logger.error(
      'api sendOTP -Error_Message -validation failed "verifyType,verifyValue,alias is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    let ipAddress =
      (
        req.headers["X-Forwarded-For"] ||
        req.headers["x-forwarded-for"] ||
        ""
      ).split(",")[0] || req.client.remoteAddress;
    let current_time = moment.utc().format("YYYY-MM-DD H:mm:ss");
    // Added the condition for email and phone type verification
    if (params.verifyType == "phone") {
      var getverifyMinQuery = `SELECT *,date_add(created_at, interval ${config.twilio.restrictotptime} SECOND ) as resending_time FROM verification_code 
          WHERE mobile_number='${params.verifyValue}' 
          AND created_at > date_sub('${current_time}', interval ${config.twilio.restrictotptime} SECOND) 
          AND origin ='Akos Connect'
          AND received_mode ='${params.verifyType}'`;
    } else if (params.verifyType == "email") {
      var getverifyMinQuery = `SELECT *,date_add(created_at, interval ${config.twilio.restrictotptime} SECOND ) as resending_time FROM verification_code 
          WHERE email='${params.verifyValue}' 
          AND created_at > date_sub('${current_time}', interval ${config.twilio.restrictotptime} SECOND) 
          AND origin ='Akos Connect'
          AND received_mode ='${params.verifyType}'`;
    }
    // Added the condition for email and phone type verification

    // "SELECT * FROM `verification_code` WHERE (`email`='" +
    // params.verifyValue +
    // "' or `mobile_number`= '" +
    // params.verifyValue +
    // "') AND `created_at` > date_sub(now(), interval '" +
    // config.twilio.restrictotptime +
    // "' SECOND) AND origin ='" +
    // 'Akos Connect' +
    // "' AND received_mode ='" +
    // params.verifyType +
    // "'";
    db.query(getverifyMinQuery, function (err, selectrows, fields) {
      if (err) {
        logger.error(
          "api sendOTP -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
        return false;
      } else {
        if (selectrows.length > 0) {
          res.status(429).json({
            status_code: 429,
            status_message:
              "Too many attempts, We already sent OTP to your  " +
              params.verifyType,
            result: {
              resending_time: moment(selectrows[0].resending_time).format(
                "YYYY-MM-DD H:mm:ss"
              ),
            },
          });
          return false;
        } else {
          var getExpiryMinQuery = "SELECT value FROM settings WHERE id = 13";
          db.query(getExpiryMinQuery, function (err, rows, fields) {
            if (err) {
              logger.error(
                "api sendOTP -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
              return false;
            } else {
              if (rows) {
                var getDocIDFromAliasQuery =
                  "SELECT id FROM connect_provider WHERE  room_alias = '" +
                  params.alias +
                  "' OR room = '" +
                  params.alias +
                  "'";
                db.query(getDocIDFromAliasQuery, function (err, rows1, fields) {
                  if (err) {
                    logger.error(
                      "api sendOTP -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "  :",
                      __line
                    );
                    res.status(500).json({
                      status_code: 500,
                      status_message: "internal server error",
                    });
                  } else {
                    if (rows1.length > 0) {
                      var docIDData = {};
                      docIDData.doc_id = rows1[0].id;
                      var otpParam = {};
                      var expireMinutes = rows[0].value;
                      var curDate = moment.utc().format("YYYY-MM-DD HH:mm:ss");
                      var expiredTime = moment(curDate)
                        .add(expireMinutes, "minutes")
                        .format("YYYY-MM-DD HH:mm:ss");
                      var generatedOTP =
                        Math.floor(Math.random() * 900000) + 100000;
                      otpParam.received_mode = params.verifyType;
                      otpParam.origin = "Akos Connect";
                      otpParam.otp = generatedOTP;
                      otpParam.expiry_timestamp = expiredTime;
                      otpParam.module = "Akos Connect";
                      otpParam.created_at = curDate;
                      otpParam.ip_address = ipAddress;
                      if (params.verifyType == "phone") {
                        otpParam.mobile_number = params.verifyValue;
                        otpParam.email = "";
                        SMSServer.messages.create(
                          {
                            to: "+91" + params.verifyValue,
