/* update call disconnect reason in connect call log */
exports.updatetcalldisconnectreason = function (req, res) {
  logger.info(
    "api  updatetcalldisconnectreason session id=" + req.body.sessionId
  );
  var params = { sessionId: req.body.sessionId, reason: req.body.reason };
  if (!params.sessionId || params.sessionId == undefined) {
    logger.error(
      'api updatetcalldisconnectreason -Error_Message -validation failed "sessionId is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  } else {
    var query =
      "select call_id From connect_waiting_room WHERE session = '" +
      params.sessionId +
      "'";
    db.query(query, function (err, rows, fields) {
      if (err) {
        logger.error(
          "api updatetcalldisconnectreason -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          "  :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows) {
          var query =
            "UPDATE connect_call_log SET call_disconnected_reason = '" +
            params.reason +
            "' WHERE call_id= " +
            rows[0].call_id;
          db.query(query, function (err, rows, fields) {
            if (err) {
              logger.error(
                "api updatetcalldisconnectreason -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              if (rows) {
                res.status(200).json({
                  status_code: 200,
                  status_message: "successfully updated data",
                  result: rows,
                });
              } else {
                res
                  .status(404)
                  .json({ status_code: 404, status_message: "id not found" });
              }
            }
          });
        } else {
          res
            .status(404)
            .json({ status_code: 404, status_message: "id not found" });
        }
      }
    });
  }
};
/* save session, token to invite table doc api start */
exports.invite = function (req, res) {
  logger.info("api invite session ", req.body.body.session);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.Authorization_Token == "") {
    logger.error(
      'api invite -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = {
        session: req.body.body.session,
        token: req.body.body.token,
      };
      if (params.session == "" || params.token == "") {
        logger.error(
          'api invite -Error_Message -validation failed "session,token is required"   :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "invalid parameter or value passed",
        });
        return false;
      } else {
        var sql = db.query(
          "SELECT invite_id FROM connect_thirdparty_url WHERE session_id= '" +
            params.session +
            "' AND token= '" +
            params.token +
            "'",
          params,
          function (err, rows, fields) {
            if (err) {
              logger.error(
                "api invite -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "  :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
              return false;
            } else {
              if (rows) {
                res.status(200).json({
                  status_code: 200,
                  status_message: "invite id",
                  result: rows,
                });
              } else {
                res.status(404).json({
                  status_code: 404,
                  status_message: "sorry unable to save",
                });
              }
            }
          }
        );
      }
    }
  });
};
/* save session, token to invite table doc api end */
