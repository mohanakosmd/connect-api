exports.emailRoomLink = function (req, res) {
  logger.info("api emailRoomLink email/phone", req.body.body.patientEmail);
  var headers = { token: req.body.headers.Authorization_Token };
  if (headers.token == "") {
    logger.error(
      'api emailRoomLink -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  logger.info("api docName found Step 1");
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      var params = {
        patientEmail: req.body.body.patientEmail,
        docMeetingEmailLink: req.body.body.docMeetingEmailLink,
        docName: req.body.body.docName,
      };

      if (isBlackListedMeetingRoom(params.docMeetingEmailLink)) {
        res
          .status(403)
          .json({ status_code: 403, status_message: "Forbidden." });
        return false;
      }
      if (
        params.patientEmail == "" ||
        params.docMeetingEmailLink == "" ||
        params.docName == ""
      ) {
        logger.error(
          'api emailRoomLink -Error_Message -validation failed "patientEmail,docMeetingEmailLink,docName is required"   :',
          __line
        );
        res.status(201).json({
          status_code: 201,
          status_message: "invalid parameter or value passed",
        });
        return false;
      } else {
        logger.info("api docName found", params.docName);
        if (params.docName != undefined) {
          var msg = {
            to: params.patientEmail
              ? params.patientEmail
              : "draj@akosmdtech.com",
            from: config.app.mailSender,
            subject: "AkosConnect Video Conference Activation",
            html:
              '\
							<p>Hello there:</p>\
							<p style="margin-bottom: 1px;">Please join our video conference by selecting the link below. This link will be active immediately and you may wait in the virtual waiting room until I activate our video conference.<br><br>\
							<a style="color:#fff;text-decoration:none;padding:6px;background:#337ab7;" href="' +
              params.docMeetingEmailLink +
              '" target="_blank">JOIN MY LINK</a>\
							<br><br><p style="margin-top: 0px;">Following are requirements to join the video conference:</p>\
							<ul style="padding-left: 10px;line-height: 18px;list-style:none;">\
								<li>1. Open the link on a laptop/desktop computer. The link will not open on a mobile device.</li>\
								<li>2. Open the link in Chrome or Firefox browser. </li>\
								<li>3. Your laptop must have a working microphone and camera.</li>\
							</ul>\
							<p>This link is only active for your use. If another participant will be joining our video conference, I will forward a link to each participant after our video conference begins. Up to four participants may join.</p>\
							<p>Thank you.</p>\
							<p>' +
              params.docName +
              "</p>",
          };
        } else {
          var msg = {
            to: params.patientEmail
              ? params.patientEmail
              : "draj@akosmdtech.com",
            from: "Akos <info@akosmd.in>",
            subject: "See me on my personal consultation room",
            html:
              '\
							<p>Hello there:</p>\
							<p style="margin-bottom: 1px;">Please click on the link below to start video conferencing with me.<br><br>\
							<a style="color:#fff;text-decoration:none;padding:6px;background:#337ab7;" href="' +
              params.docMeetingEmailLink +
              '" target="_blank">JOIN MY LINK</a>\
							<br><br><p style="margin-top: 0px;">Following are requirements to join the video conference:</p>\
							<ul style="padding-left: 10px;line-height: 18px;list-style:none;">\
								<li>1. Open the link on a laptop/desktop computer. The link will not open on a mobile device.</li>\
								<li>2. Open the link in Chrome or Firefox browser. </li>\
								<li>3. Your laptop must have a working microphone and camera.</li>\
							</ul>\
							<p>I will see you there.</p>\
							<p>Thank you.</p>',
          };
        }
        mailServer.send(msg, function () {
          res.status(200).json({
            status_code: 200,
            status_message: "mail sent successfully",
          });
        });
      }
    }
  });
};
exports.sendCustomLink = function (req, res) {
  logger.info("api sendCustomLink email/phone", req.body.emailphone);
  if (
    !req.body.emailphone ||
    req.body.emailphone == "" ||
    !req.body.customLink ||
    req.body.customLink == ""
  ) {
    logger.error(
      'api sendCustomLink -Error_Message -validation failed "email or phone and link is required"   :',
      __line
    );
    res.status(400).json({
      status_code: 400,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  if (req.body.type == "email") {
    var msg = {
      to: req.body.emailphone,
      from: config.app.mailSender,
      subject: req.body.subject
        ? req.body.subject
        : "AkosConnect Video Conference Activation",
      html: req.body.customLink,
    };
    mailServer.send(msg, function () {
      res
        .status(200)
        .json({ status_code: 200, status_message: "mail sent successfully" });
    });
  } else {
    SMSServer.messages.create(
      {
        to: config.twilio.phonePref + "" + req.body.emailphone,
        from: config.app.smsFrom,
        body: req.body.customLink,
      },
      function (err, message) {
        alert(err);
        if (err) {
          logger.error(
            "api SMSlRoomLink -Error_Message :-",
            err,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "SMS was not sent 99999.",
            error_status: err,
          });
        } else {
          res.status(200).json({
            status_code: 200,
            status_message: "SMS sent successfully.",
          });
        }
      }
    );
  }
};
/* send mail api end */

