exports.getOpentokRoomKeys = function (req, res) {
  logger.info("api getOpentokRoomKeys patient_id", req.body.id);
  var params = { id: req.body.id };
  if (params.id == "") {
    logger.error(
      'api getOpentokRoomKeys -Error_Message -validation failed "id is required"  :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "inavlid parameter or value passed",
    });
    return false;
  }
  var sql = db.query(
    "SELECT id,session,token FROM connect_waiting_room WHERE patient_id='" +
      params.id +
      " '",
    function (err, rows, fields) {
      if (err) {
        logger.error(
          "api getOpentokRoomKeys -Error_Code :-",
          err.code,
          "Error_Message :-",
          err.sqlMessage,
          " :",
          __line
        );
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (rows.length == 1) {
          res.status(200).json({
            status_code: 200,
            status_message: "opentok keys",
            result: rows,
          });
        } else {
          logger.info(rows.length);
          res
            .status(404)
            .json({ status_code: 404, status_message: "keys not found" });
        }
      }
    }
  );
};
