/**
 *  get archive id from session api start
 */
exports.getArchiveId = function (req, res) {
  logger.info("api  getArchiveId uuid=", req.params.uuid);
  var nameArchieve = "video_recording_" + req.params.uuid + "_" + new Date();
  opentok.startArchive(
    req.params.sessionId,
    { name: nameArchieve },
    function (err, archive) {
      if (err) {
        logger.warn("api getArchiveId -Error_Code :-", err, "  :", __line);
        res
          .status(500)
          .json({ status_code: 500, status_message: "internal server error" });
      } else {
        if (archive.id) {
          var q =
            "UPDATE connect_waiting_room SET archive_id ='" +
            archive.id +
            "'  WHERE session='" +
            req.params.sessionId +
            "'";
          db.query(q, function (err, rows) {
            if (err) {
              logger.error(
                "api getArchiveId -Error_Code :-",
                err.code,
                "Error_Message :-",
                err.sqlMessage,
                "   :",
                __line
              );
              res.status(500).json({
                status_code: 500,
                status_message: "internal server error",
              });
            } else {
              db.query(
                "UPDATE connect_call_log SET archive_id = '" +
                  archive.id +
                  "' WHERE sessionid ='" +
                  req.params.sessionId +
                  "'",
                function (err, rowsupdae, fields) {
                  if (err) {
                    logger.error(
                      "api getArchiveId -Error_Code :-",
                      err.code,
                      "Error_Message :-",
                      err.sqlMessage,
                      "   :",
                      __line
                    );
                    res.status(200).json({
                      status_code: 200,
                      status_message: "recording started",
                      result: archive.id,
                    });
                  } else {
                    if (rowsupdae) {
                      res.status(200).json({
                        status_code: 200,
                        status_message: "recording started",
                        result: archive.id,
                      });
                    }
                  }
                }
              );
            }
          });
        }
      }
    }
  );
};
