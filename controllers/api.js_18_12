exports.doctorAvailableUnavailable = function (req, res) {
  // logger.info('api doctorAvailableUnavailable');
  var headers = { token: req.headers.authorization_token };
  if (
    headers.token == "" ||
    headers.token == undefined ||
    headers.token == null
  ) {
    logger.error(
      'api doctorAvailableUnavailable -Error_Message -validation failed "Authorization_Token is required"   :',
      __line
    );
    res.status(201).json({
      status_code: 201,
      status_message: "invalid parameter or value passed",
    });
    return false;
  }
  validateToken(headers.token, function (err, result) {
    if (err) {
      res
        .status(500)
        .json({ status_code: 500, status_message: "internal server error" });
    }
    if (result.status_code == 200) {
      let q =
        "select distinct doctor.degree,doctor.id,doctor.name,doctor.email,doctor.gender,doctor.is_available,doctor.phoneNo,doctor.dateOfBirth,doctor.npiNumber,doctor.address,doctor.city,doctor.pinCode,doctor.verified,doctor.is_urgent_care,doctor.approved,doctor.status,doctor.createdAt,doctor.role,doctor.last_call_picked_at,GROUP_CONCAT( doctor_licensed_states.state ) as tab1 ,initial_form_detail.imageUrl from doctor LEFT JOIN doctor_licensed_states ON doctor_licensed_states.doctor_id=doctor.id LEFT JOIN  initial_form_detail on initial_form_detail.doctorId = doctor.id where doctor.approved = 1 and doctor.status = 1 and doctor.is_call_has_gone = 0 group by doctor.id";
      db.query(q, function (err, rows) {
        if (err) {
          logger.error(
            "api doctorAvailableUnavailable -Error_Code :-",
            err.code,
            "Error_Message :-",
            err.sqlMessage,
            "  :",
            __line
          );
          res.status(500).json({
            status_code: 500,
            status_message: "internal server error",
          });
          return false;
        } else {
          if (rows.length > 0) {
            res.status(200).json({
              status_code: 200,
              status_message: "online doctor",
              result: rows,
            });
          } else {
            res
              .status(404)
              .json({ status_code: 404, status_message: "data not found" });
          }
        }
      });
    }
  });
};
